#!/usr/bin/env python3
"""gsdf - deterministic state tool for GSDF. Filesystem is the source of truth (spec 4a)."""
VERSION = "1.4.0"
import fcntl, hashlib, json, os, re, shutil, subprocess, sys, tempfile
from contextlib import contextmanager
from datetime import datetime, date
from pathlib import Path

def die(m): sys.stderr.write(m.rstrip() + "\n"); sys.exit(1)
def read(p):
    try: return Path(p).read_text(encoding="utf-8", errors="replace")
    except OSError: return ""
def slug(s): return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", s.lower())).strip("-") or "phase"
def norm(n): return str(float(n)).rstrip("0").rstrip(".") if "." in str(n) else str(int(n))
def key(n): return float(n)

def planning():
    d = Path.cwd().resolve()
    for c in [d, *d.parents]:
        if (c / ".planning").is_dir(): return c / ".planning"
    return None
def need(): return planning() or die("no .planning/ found — run `gsdf init <name>` or `/gsdf:new-project`")

# ---------- parsing ----------
def frontmatter(t):
    if not t.startswith("---"): return {}
    e = t.find("\n---", 3)
    if e < 0: return {}
    return {m[1]: m[2].strip() for m in (re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", l) for l in t[3:e].splitlines()) if m}
def fm_value(t, *path):
    """A frontmatter value that may be NESTED. frontmatter() is flat, but GSD-era planners write
    `estimate:` / `  tokens: 70000` -- read flat, that key does not exist, and lint failed every
    such plan for a field it actually carried."""
    if not t.startswith("---"): return ""
    e = t.find("\n---", 3)
    body = t[3:e] if e > 0 else ""
    for k in path[:-1]:
        m = re.search(r"^[ \t]*%s:[ \t]*\n((?:[ \t]+.*(?:\n|$))+)" % re.escape(k), body, re.M)
        if not m: return ""
        body = m.group(1)
    m = re.search(r"^[ \t]*%s:[ \t]*(.*)$" % re.escape(path[-1]), body, re.M)
    return m.group(1).strip() if m else ""
def as_list(v):
    v = (v or "").strip()
    if v.startswith("[") and v.endswith("]"): v = v[1:-1]
    return [x.strip().strip("\"'") for x in v.split(",") if x.strip()]
def dep_id(d):
    m = re.match(r"^\d+(?:\.\d+)?-(\d+)$", d.strip().strip("\"'"))
    return m.group(1) if m else d.strip().strip("\"'")
def section(t, *names):
    for n in names:
        m = re.search(r"^#{1,4}\s*%s\s*$(.*?)(?=^#{1,4}\s|\Z)" % n, t, re.M | re.S | re.I)
        if m and m.group(1).strip(): return m.group(1).strip()
    return ""
def cap(t, n): return "\n".join(t.splitlines()[:n])
def tail(t, n): return "\n".join(t.splitlines()[-n:])

ROADMAP_RE = re.compile(r"^[ \t]*(?:[-*][ \t]*\[[ xX✅⏳]?\][ \t]*)?#{0,4}[ \t]*\*{0,2}Phase[ \t]+(\d+(?:\.\d+)?)[ \t]*[:–—-][ \t]*(.+)$", re.M)
def roadmap_phases(pl):
    out = {}
    for m in ROADMAP_RE.finditer(read(pl / "ROADMAP.md")):
        n = norm(m.group(1))
        if n in out: continue
        name = re.split(r"\s+[-–—]\s+", m.group(2).split("**")[0])[0].strip(" *:—-")
        out[n] = name or ("phase-" + n)
    return out

# GSD's `project_code` names directories `MS-22-slug` while the files inside stay `22-01-PLAN.md`.
# Matching only a leading number made every such phase invisible: `plans 22` returned [], and
# `phase dir 27` created a second, empty `27-slug/` beside the real one.
PDIR_RE = re.compile(r"^(?:[A-Z][A-Z0-9]{0,7}-)?(\d{2,3}(?:\.\d+)?)-(.+)$")
def dir_phases(pl):
    out = {}
    code = str(config(pl).get("project_code") or "").strip()
    # With a project_code, its prefixed directory is the real one; sort it first so a stray
    # unprefixed duplicate (which older gsdf created) never shadows it.
    ds = sorted((pl / "phases").glob("*"), key=lambda d: (not (code and d.name.startswith(code + "-")), d.name)) \
         if (pl / "phases").is_dir() else []
    for d in ds:
        m = PDIR_RE.match(d.name)
        if not (d.is_dir() and m): continue
        n = norm(m.group(1))
        if n in out:   # never silently drop a phase directory: its plans would vanish
            sys.stderr.write("warning: phase %s claimed by both %s and %s — using %s\n"
                             % (n, out[n][2].name, d.name, out[n][2].name))
            continue
        out[n] = (m.group(1), m.group(2), d)
    return out

def plans_of(pdir, prefix):
    out = []
    if not pdir: return out
    for f in sorted(pdir.glob(prefix + "-*-PLAN.md")):
        m = re.match(r"^%s-(\d+)-PLAN\.md$" % re.escape(prefix), f.name)
        if not m: continue
        txt = read(f); fm = frontmatter(txt); pid = m.group(1)
        s = pdir / ("%s-%s-SUMMARY.md" % (prefix, pid))
        files = sorted({x.strip() for grp in re.findall(r"<files>(.*?)</files>", txt, re.S) for x in grp.split(",") if x.strip()}
                       | set(as_list(fm.get("files_modified"))))
        out.append({"id": pid, "file": str(f), "depends_on": [dep_id(x) for x in as_list(fm.get("depends_on"))],
                    "has_depends": "depends_on" in fm, "wave": fm.get("wave"), "files": files, "has_summary": s.exists(),
                    "status": (frontmatter(read(s)).get("status", "complete") if s.exists() else "pending")})
    return out

def uat_passed(t):
    if re.search(r"^status:\s*(passed|pass|complete|approved)\s*$", t, re.M | re.I): return True
    if re.search(r"^\s*\*{0,2}Status\*{0,2}:\s*PASS", t, re.M): return True
    if re.search(r"^#{1,4}\s*Result:\s*pass", t, re.M | re.I): return True
    r = re.findall(r"^\s*result:\s*(\S+)", t, re.M | re.I)
    if r and all(x.lower() == "pass" for x in r): return True
    b = re.findall(r"\[([ xX])\]", t)
    return bool(b) and all(x.lower() == "x" for x in b)

def status_of(pdir, prefix):
    """Spec 4a: first match wins. Filesystem is truth; STATE.md and ROADMAP.md are never trusted."""
    if not pdir or not pdir.is_dir(): return "plan"
    f = lambda s: pdir / ("%s-%s.md" % (prefix, s))
    if f("ITERATIONS").exists() and re.search(r"^status:\s*approved", read(f("ITERATIONS")), re.M): return "complete"
    if f("UAT").exists() and uat_passed(read(f("UAT"))): return "complete"
    if f("VERIFICATION").exists() and re.search(r"passed|PASS", read(f("VERIFICATION"))): return "complete"
    pl = plans_of(pdir, prefix)
    if not pl: return "plan"
    # A blocked or partial summary is not a finished plan. Counting it as one makes a phase
    # that failed to build look executed, and sends the user into iterate mode on work that
    # does not exist.
    if any(x["status"] in ("blocked", "partial") for x in pl if x["has_summary"]): return "blocked"
    return "iterate" if all(x["has_summary"] for x in pl) else "execute"

def phases(pl):
    rm, dp, out = roadmap_phases(pl), dir_phases(pl), []
    for n in sorted(set(rm) | set(dp), key=key):
        prefix, sl, d = dp[n] if n in dp else (n.zfill(2), slug(rm[n]), None)
        out.append({"num": n, "prefix": prefix, "slug": sl, "dir": d, "name": rm.get(n, sl), "status": status_of(d, prefix)})
    return out
def progressed(p):
    """Work has started here: a plan, a summary or an iterations file exists."""
    d = p["dir"]
    return bool(d and d.is_dir() and (any(d.glob(p["prefix"] + "-*-PLAN.md")) or iter_file(p).exists()))
def current(pl, ph=None, warn=False):
    """The first phase not complete -- except one that was executed but never formally approved
    while a LATER phase has since started. That is a phase the user moved past (typically a
    project adopted mid-flight), and pointing `next` back at it sent the session to iterate on
    finished work while the real one was open. It is reported, not silently skipped."""
    ph = ph if ph is not None else phases(pl)
    open_ = [p for p in ph if p["status"] != "complete"]
    for i, p in enumerate(open_):
        later = [q for q in ph if key(q["num"]) > key(p["num"]) and progressed(q)]
        if p["status"] == "iterate" and later:
            if warn: sys.stderr.write("note: phase %s was executed but never approved, and phase %s has "
                                      "since started — `gsdf phase advance %s` closes it\n"
                                      % (p["prefix"], later[-1]["prefix"], p["prefix"]))
            continue
        return p
    return None
def new_dir(pl, p):
    """Create a phase's directory the way this project names them."""
    code = str(config(pl).get("project_code") or "").strip()
    p["dir"] = pl / "phases" / ("%s%s-%s" % (code + "-" if code else "", p["prefix"], p["slug"]))
    p["dir"].mkdir(parents=True, exist_ok=True)
    return p["dir"]
def find(pl, arg):
    ph = phases(pl)
    if arg in (None, "", "current"):
        return current(pl) or die("every phase is complete — run `gsdf next`")
    n = norm(re.sub(r"[^\d.]", "", str(arg)) or die("bad phase: %s" % arg))
    return next((p for p in ph if p["num"] == n), None) or die("phase %s not found" % arg)

def waves(plans):
    ids = [p["id"] for p in plans]
    if not ids: return []
    if all(p["has_depends"] for p in plans):
        rem = {p["id"]: set(p["depends_on"]) & set(ids) for p in plans}
        out = []
        while rem:
            layer = sorted([i for i, d in rem.items() if not d]) or sorted(rem)
            out.append(layer)
            for i in layer: rem.pop(i)
            for d in rem.values(): d -= set(layer)
        return out
    if all(p["wave"] for p in plans):
        g = {}
        for p in plans: g.setdefault(int(re.sub(r"\D", "", p["wave"]) or 1), []).append(p["id"])
        return [sorted(g[k]) for k in sorted(g)]
    return [[i] for i in ids]

def dep_cycle(plans):
    """Plan ids that can never be scheduled, because each waits on another that also waits.

    waves() breaks that deadlock by emitting the survivors as one layer -- which silently
    turns a circular dependency into a PARALLEL wave, the exact opposite of what the plans
    declared. Detecting it belongs in lint, where /gsdf:plan can still act on it."""
    ids = {p["id"] for p in plans}
    if not plans or not all(p["has_depends"] for p in plans): return []
    rem = {p["id"]: (set(p["depends_on"]) & ids) - {p["id"]} for p in plans}
    while rem:
        free = [i for i, d in rem.items() if not d]
        if not free: return sorted(rem)
        for i in free: rem.pop(i)
        for d in rem.values(): d -= set(free)
    return []

@contextmanager
def locked(pl):
    """Serialise read-modify-write on .planning/. An orchestrator fires independent Bash calls
    in parallel — six concurrent `state defer` calls landed three of six lines without this.
    The lock lives in the system temp dir, keyed by path, so nothing is added to the repo."""
    key = hashlib.sha1(str(Path(pl).resolve()).encode()).hexdigest()[:16]
    f = open(Path(tempfile.gettempdir()) / ("gsdf-%s.lock" % key), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield
    finally:
        try: fcntl.flock(f, fcntl.LOCK_UN)
        finally: f.close()

# ---------- STATE.md ----------
POS = r"(?:Current[ \t]+)?Position|Current[ \t]+Status"
def head_span(t, pat):
    m = re.search(r"^#{1,4}[ \t]*(?:%s)[ \t]*$" % pat, t, re.M | re.I)
    if not m: return None
    nxt = re.search(r"^#{1,4}[ \t]", t[m.end():], re.M)
    return (m.start(), m.end(), m.end() + (nxt.start() if nxt else len(t) - m.end()))
def state_file(pl): return pl / "STATE.md"
def cmd_state(pl):
    t = read(state_file(pl)) or die("STATE.md not found")
    fm = t[:t.find("\n---", 3) + 4] if t.startswith("---") and t.find("\n---", 3) > 0 else ""
    sp = head_span(t, POS)
    # Lead with what the filesystem says, and name any frontmatter key that disagrees with it.
    # STATE.md is read tolerantly, which must not mean it is believed over the tree.
    tr, f = state_truth(pl), {}
    for k in LEGACY:
        m = re.search(r"^[ \t]*%s:[ \t]*(.*)$" % k, fm, re.M)
        if m: f[k] = m.group(1).strip().strip("\"'")
    stale = [k for k in ("current_phase", "completed_phases", "total_phases") if k in f
             and norm_maybe(f[k]) != norm_maybe(tr[k])]
    print("filesystem: phase %s (%s) · %s/%s phases complete" % (tr["current_phase"] or "-", tr["current_phase_name"],
          tr["completed_phases"], tr["total_phases"]))
    if stale: print("STALE in STATE.md: %s — trust the line above; `gsdf state sync` rewrites them"
                    % ", ".join("%s=%s (is %s)" % (k, f[k], tr[k]) for k in stale))
    print()
    print((fm + "\n" + (t[sp[0]:sp[2]] if sp else cap(t, 15))).strip())
def norm_maybe(v):
    try: return norm(v)
    except ValueError: return v
def write_state(pl, t): state_file(pl).write_text(t, encoding="utf-8")
# Keys GSD writes into STATE.md that gsdf derives from the filesystem. gsdf only ever wrote
# `phase:`, so a GSD-era STATE.md kept `current_phase: 01.1` / `completed_phases: 0` forever,
# printed right above the truth -- and agents believed the stale line.
LEGACY = ("current_phase", "current_phase_name", "completed_phases", "total_phases",
          "percent", "completed_plans", "total_plans")
def state_truth(pl, nxt=None):
    ph = phases(pl)
    nxt = nxt if nxt is not None else current(pl, ph)
    allp = [x for p in ph for x in plans_of(p["dir"], p["prefix"])]
    done = sum(1 for p in ph if p["status"] == "complete")
    return {"current_phase": nxt["prefix"] if nxt else ph[-1]["prefix"] if ph else "",
            "current_phase_name": nxt["name"] if nxt else "milestone-done",
            "completed_phases": str(done), "total_phases": str(len(ph)),
            "percent": str(int(100 * done / len(ph)) if ph else 0),
            "completed_plans": str(sum(1 for x in allp if x["has_summary"])), "total_plans": str(len(allp))}
def state_sync(pl, nxt=None):
    """Rewrite whichever LEGACY keys the frontmatter already has, at any indentation (GSD nests
    the counts under `progress:`). Keys that are absent stay absent -- gsdf adds nothing new."""
    t = read(state_file(pl))
    e = t.find("\n---", 3) if t.startswith("---") else -1
    if e < 0: return
    head, truth = t[3:e], state_truth(pl, nxt)
    for k in LEGACY:
        v = truth[k]
        if k == "current_phase_name": v = json.dumps(v, ensure_ascii=False) if re.search(r"[:#]", v) else v
        head = re.sub(r"^([ \t]*%s:)[ \t]*.*$" % k, lambda m: m.group(1) + " " + v, head, count=1, flags=re.M)
    write_state(pl, "---" + head + t[e:])
def state_set(pl, k, v):
    # The value is DATA, never a replacement template. Passing it as one made a backslash
    # an escape sequence -- `state set status "C:\temp\new"` silently stored "C:<tab>emp",
    # `\1` crashed with a traceback, and `\g<0>` injected the whole matched line. A lambda
    # replacement is substituted literally.
    lit = lambda s: (lambda m: s)
    t = read(state_file(pl)) or die("STATE.md not found")
    if t.startswith("---") and t.find("\n---", 3) > 0:
        e = t.find("\n---", 3)
        head, body = t[3:e], t[e:]
        if re.search(r"^%s:" % re.escape(k), head, re.M):
            head = re.sub(r"^%s:.*$" % re.escape(k), lit("%s: %s" % (k, v)), head, count=1, flags=re.M)
        else: head = head.rstrip("\n") + "\n%s: %s\n" % (k, v)
        t = "---" + head + body
    else:
        c = "<!-- gsdf: %s=%s -->" % (k, v)
        t = re.sub(r"^<!-- gsdf: %s=.*-->$" % re.escape(k), lit(c), t, count=1, flags=re.M) if re.search(
            r"^<!-- gsdf: %s=" % re.escape(k), t, re.M) else re.sub(r"^(#[^\n]*\n)", lambda m: m.group(1) + "\n" + c + "\n", t, count=1) or t + "\n" + c + "\n"
    write_state(pl, t)
def state_append(pl, pat, title, line):
    t = read(state_file(pl)) or die("STATE.md not found")
    sp = head_span(t, pat)
    if sp: t = t[:sp[2]].rstrip("\n") + "\n" + line + "\n\n" + t[sp[2]:]
    else: t = t.rstrip("\n") + "\n\n## %s\n\n%s\n" % (title, line)
    write_state(pl, t)
def state_position(pl, text):
    t = read(state_file(pl)) or die("STATE.md not found")
    sp = head_span(t, POS)
    if sp: t = t[:sp[1]] + "\n\n" + text + "\n\n" + t[sp[2]:]
    else: t = t.rstrip("\n") + "\n\n## Position\n\n" + text + "\n"
    write_state(pl, re.sub(r"\n{3,}", "\n\n", t))

# ---------- context ----------
def config(pl, strict=False):
    raw = read(pl / "config.json")
    try: return json.loads(raw or "{}")
    except json.JSONDecodeError as e:
        # Readers carry on with defaults; a writer must never overwrite a file it cannot parse.
        if strict: die("config.json is not valid JSON (%s) — fix it before adopting; "
                       "refusing to overwrite it and lose the keys it holds" % e)
        return {}
def phase_num_re(n):
    """`Phase 3` and `Phase 03.1` are the same heading style written by different hands, so the
    number has to match however it is padded. num is normalized ("3", "3.1") while /gsdf:phase
    writes inserted phases padded ("### Phase 03.1:") -- comparing them literally found nothing
    and silently dropped the goal AND the requirements block from every decimal phase's context.
    The lookahead keeps phase 3 off phase 3.1's heading, which a bare \\b would have allowed."""
    return r"\.".join(r"0*" + re.escape(c) for c in str(n).split(".")) + r"(?![\d.])"
def roadmap_entry(pl, p):
    t = read(pl / "ROADMAP.md")
    m = re.search(r"^#{2,4}[ \t]*\*{0,2}Phase[ \t]+%s.*$" % phase_num_re(p["num"]), t, re.M)
    if not m: return ""
    nxt = re.search(r"^#{2,4}[ \t]", t[m.end():], re.M)
    return t[m.start():m.end() + (nxt.start() if nxt else len(t) - m.end())].strip()
# A requirement id is any short uppercase tag, not just REQ-. Hardcoding REQ-\d+ meant a
# project numbering by domain -- ENG-01, LAYER-03, SCENE-07 -- got NO requirements block at
# all, ever, and nothing said so. The checkbox marker is equally load-bearing: requirements
# are commonly written `- [ ] **ENG-01**: ...`, which the old bullet pattern did not match
# either, so generalizing the id alone would have fixed nothing for such a project.
REQ_ID = r"[A-Z][A-Z0-9]{1,7}-\d+"
REQ_START = re.compile(r"^\s*(?:[-*+]|\d+\.)\s*(?:\[[ xX✅⏳]?\]\s*)?\**\s*(%s)\b" % REQ_ID)
# Not preceded by another id character, so `V2-ENG-01` does not read as `ENG-01`.
REQ_MENTION = re.compile(r"(?<![A-Z0-9-])(%s)\b" % REQ_ID)
def req_ids(text):
    """Every id REQUIREMENTS.md actually DEFINES as a bullet. Intersecting against this is what
    keeps a general id pattern honest -- `UTF-8` or `SHA-256` in a roadmap's prose looks exactly
    like a requirement reference and must not become one."""
    return {m.group(1) for m in (REQ_START.match(l) for l in text.splitlines()) if m}
def req_blocks(text, wanted):
    """A requirement is a bullet plus its continuation lines, and only from a v1/v2 section.
    Line-filtering truncates wrapped requirements and lets an out-of-scope bullet that merely
    mentions an id masquerade as one."""
    out, keep, skip = [], False, False
    for line in text.splitlines():
        h = re.match(r"^#{1,4}\s*(.+)$", line)
        if h:
            skip = bool(re.search(r"out.of.scope|non-goals?|deferred", h.group(1), re.I))
            keep = False
            continue
        m = REQ_START.match(line)
        if m: keep = (m.group(1) in wanted) and not skip
        elif keep and line.strip() and not REQ_START.match(line) and not line[:1].strip():
            pass                      # indented continuation of the kept bullet
        elif keep and not line.strip():
            keep = False              # blank line ends the block
        elif keep:
            keep = False              # a new unindented bullet that is not a REQ
        if keep and line.strip(): out.append(line.rstrip())
    return out

# Word budgets for the two sections that grow with the project. A real project measured
# 2,000-5,500 tokens against spec 10's 2,500: twenty long decision lines alone ran to 1,100
# words, and a previous phase's Delivered sections to 2,600. Lines, not words, were capped,
# and dense prose makes a line cap meaningless.
DEC_WORDS, PREV_WORDS = 450, 350
def fit(lines, words, newest_last=False, more=""):
    """Whole lines up to a word budget -- from the end when the newest matter most."""
    src = list(reversed(lines)) if newest_last else list(lines)
    out, n = [], 0
    for l in src:
        w = len(l.split())
        if out and n + w > words: break
        out.append(l); n += w
    dropped = len([l for l in lines if l.strip()]) - len([l for l in out if l.strip()])
    if newest_last: out.reverse()
    if dropped > 0 and more: out.append("[%d more %s]" % (dropped, more))
    return out
def lead(bullet, words=30):
    """A delivered bullet's claim without its evidence: the bold lead if it has one."""
    b = bullet.strip()
    m = re.match(r"^([-*]\s*(?:[✅❌⚠️]\s*)?)\*\*(.+?)\*\*", b)
    if m: return m.group(1) + m.group(2)
    w = b.split()
    return " ".join(w[:words]) + (" …" if len(w) > words else "")

def cmd_context(pl, p):
    out, cfg, proj = [], config(pl), read(pl / "PROJECT.md")
    out.append("## Project\n\n" + cap(section(proj, "Vision", "Overview", "Core Value") or cap(proj, 15), 15))
    for f, n in (("conventions.md", "Conventions"), ("stack.md", "Stack")):
        if (pl / "codebase" / f).exists():
            out.append("### %s\n\n%s" % (n, cap(re.sub(r"\A#[ \t][^\n]*\n+", "", read(pl / "codebase" / f)), 40)))
    entry = roadmap_entry(pl, p)
    out.append("## Phase %s\n\n%s" % (p["prefix"], entry or "%s — no ROADMAP entry found." % p["name"]))
    rtext = read(pl / "REQUIREMENTS.md")
    defined = req_ids(rtext)
    cited = list(dict.fromkeys(m.group(1) for m in REQ_MENTION.finditer(entry)))
    reqs = [i for i in cited if i in defined]
    # An id the roadmap cites that REQUIREMENTS.md does not define is a broken reference, and
    # silence about it reads as "this phase has no such requirement". Only complain about ids
    # whose prefix IS defined, so prose like `WCAG-2` or `UTF-8` stays prose.
    pre = {i.rsplit("-", 1)[0] for i in defined}
    miss = [i for i in cited if i not in defined and i.rsplit("-", 1)[0] in pre]
    blocks = req_blocks(rtext, reqs) if reqs else []
    if miss: blocks.append(("\n" if blocks else "") + "[cited by the roadmap but not defined in "
                           "REQUIREMENTS.md: %s]" % ", ".join(miss))
    if blocks: out.append("## Requirements\n\n" + "\n".join(blocks))
    dec = section(read(state_file(pl)), "Decisions", "Decisions Made")
    if dec: out.append("## Decisions\n\n" + "\n".join(fit(tail(dec, 20).splitlines(), DEC_WORDS, True,
                                                             "older — STATE.md ## Decisions")))
    ctx = p["dir"] and (p["dir"] / (p["prefix"] + "-CONTEXT.md"))
    if ctx and ctx.exists():
        body, full = read(ctx).strip(), read(ctx).strip().splitlines()
        if len(full) > 120:  # a long discuss would blow the 2.5k budget; point at the file instead
            body = "\n".join(full[:120]) + "\n\n[truncated at 120 lines — read %s in full if you need the rest]" % ctx
        out.append("## Context\n\n" + body)
    ch = next((c for c in [pl / "continue-here.md", p["dir"] and p["dir"] / ".continue-here.md"] if c and c.exists()), None)
    if ch: out.append("## Handoff (continue-here.md)\n\n" + cap(read(ch).strip(), 40))
    if cfg.get("verify"): out.append("## Verify commands\n\n```json\n%s\n```" % json.dumps(cfg["verify"], indent=2))
    # Say so out loud when there are none. Silence here reads exactly like a
    # configured project, and approve's promise ("nothing was approved that
    # doesn't build") is unenforceable without commands to run.
    else: out.append("## Verify commands\n\nNONE CONFIGURED — `config.json` has no `verify` entries, so there is\nnothing for execute or approve to run. Plans must carry their own\n`<verify>` commands, and approve cannot claim this phase builds. Fix with\n`gsdf init` in a project that has a build, or add `verify.build` /\n`verify.test` / `verify.ui` by hand.")
    prev = [x for x in phases(pl) if key(x["num"]) < key(p["num"]) and x["dir"]]
    if prev:
        q = prev[-1]
        b = []
        for f in sorted(q["dir"].glob(q["prefix"] + "-*-SUMMARY.md")):
            for l in (section(read(f), "Delivered") + "\n" + section(read(f), "Iterations")).splitlines():
                if l.strip() and not re.match(r"^\(.*until approve\)$", l.strip()):
                    b.append(lead(l) if re.match(r"^\s*[-*]", l) else l.rstrip())
        b = fit(b, PREV_WORDS, more="— %s-*-SUMMARY.md ## Delivered" % q["prefix"])
        if b: out.append("## Previous phase (%s)\n\n%s" % (q["prefix"], "\n".join(b)))
        # Findings are the one artefact written to be reused, so hand them over
        # deterministically instead of hoping a lexical retriever surfaces them.
        # Titles only: the planner can open the file if a title looks relevant.
        ff = q["dir"] / (q["prefix"] + "-FINDINGS.md")
        if ff.exists():
            t = [l[3:].strip() for l in read(ff).splitlines() if l.startswith("## ")]
            if t: out.append("## What the previous phase learned (%s-FINDINGS.md)\n\n%s"
                             % (q["prefix"], "\n".join("- " + x for x in t)))
    print("\n\n".join(out))
def cmd_conflicts(pl, p):
    """Two plans in the same wave must never touch the same file. Exit 1 if any do."""
    plans = {x["id"]: x for x in plans_of(p["dir"], p["prefix"])}
    bad = 0
    for w in waves(list(plans.values())):
        for i, a in enumerate(w):
            for b in w[i + 1:]:
                shared = sorted(set(plans[a]["files"]) & set(plans[b]["files"]))
                if shared:
                    bad += 1
                    print("wave conflict: %s-%s and %s-%s both write %s" % (p["prefix"], a, p["prefix"], b, ", ".join(shared)))
    if bad: sys.exit(1)
    print("no same-wave file conflicts in phase %s" % p["prefix"])

def cmd_lint(pl, p):
    """The gates /gsdf:plan applies before an executor ever sees a plan. Prose checks get
    skipped; a command does not. Exit 1 and name the plan and the problem."""
    bad = []
    pls = plans_of(p["dir"], p["prefix"])
    for x in pls:
        if x["id"] in x["depends_on"]:
            bad.append("%s-%s: depends_on lists itself" % (p["prefix"], x["id"]))
    cyc = dep_cycle(pls)
    if cyc:
        bad.append("%s: circular depends_on among %s — nothing can go first, so waves() emits "
                   "them as one parallel wave, which is the opposite of what they declared"
                   % (p["prefix"], ", ".join(cyc)))
    done = [x for x in pls if x["has_summary"]]
    for x in pls:
        # An executed plan is history, not a candidate. lint is the gate BEFORE execute, and
        # failing a GSD-era plan that already ran for lacking <fails_when> or `## Try it` -- which
        # spec 4a says old plans may lack -- is noise that buries a real finding in a new plan.
        if x["has_summary"]: continue
        f, txt = Path(x["file"]), read(x["file"])
        fm, pid = frontmatter(txt), "%s-%s" % (p["prefix"], x["id"])
        raw = fm.get("estimated_tokens") or fm_value(txt, "estimate", "tokens")
        try: est = int(re.sub(r"\D", "", raw) or 0)
        except ValueError: est = 0
        if not est: bad.append("%s: no estimated_tokens" % pid)
        elif est >= 120000: bad.append("%s: estimated_tokens %d exceeds the 120000 executor budget" % (pid, est))
        if not as_list(fm.get("requirements")): bad.append("%s: requirements is empty" % pid)
        v, fw = len(re.findall(r"<verify>", txt)), len(re.findall(r"<fails_when>", txt))
        if v and fw < v: bad.append("%s: %d <verify> but only %d <fails_when> — a command with no expressible failure mode is not an acceptance test" % (pid, v, fw))
        if not v: bad.append("%s: no <verify> in any task" % pid)
        # `<task[\s>]`, not `<task`: the latter also counted the `<tasks>` CONTAINER, so every
        # plan written with one reported a missing <done> it did not have.
        if len(re.findall(r"<task[\s>]", txt)) > len(re.findall(r"<done>", txt)):
            bad.append("%s: a task has no <done>" % pid)
        if not section(txt, "Try it"): bad.append("%s: no '## Try it' — the user cannot see the result" % pid)
        # The user is never told to build: `gsdf rebuild` runs before every handoff. A Try-it
        # that says "first run cmake --build" is the step the user asked never to see again.
        elif BUILD_CMD.search(section(txt, "Try it")):
            bad.append("%s: '## Try it' tells the user to build (%s) — `gsdf rebuild` does that; say what to try"
                       % (pid, BUILD_CMD.search(section(txt, "Try it")).group(0)))
    # Zero plans is not zero problems. /gsdf:plan runs this as its gate, so a planner
    # that wrote nothing scored "0 plan(s) pass all gates" and exit 0 -- a green light
    # on an empty phase, which is the one failure the gate exists to catch.
    n = len(pls)
    if not n:
        print("phase %s: no PLAN.md files — nothing to execute" % p["prefix"])
        sys.exit(1)
    for b in bad: print(b)
    if done: print("(%d already-executed plan(s) not gated: %s)" % (len(done), ", ".join(x["id"] for x in done)))
    if bad: sys.exit(1)
    if n == len(done): return print("phase %s: every plan already executed — nothing to gate" % p["prefix"])
    print("phase %s: %d plan(s) pass all gates" % (p["prefix"], n - len(done)))

BUILD_CMD = re.compile(r"cmake\s+(--build|-B)|npm\s+(run\s+(build|dev)|install|ci)\b|xcodebuild|msbuild|\bmake\s+(-j|all|install)", re.I)
def cmd_tryit(pl, p):
    files = sorted(p["dir"].glob(p["prefix"] + "-*-SUMMARY.md")) if p["dir"] else []
    for f in files:
        t = read(f); hc = section(t, "Needs human check")
        body = "\n\n".join(x for x in [section(t, "Try it"), "**Needs human check**\n" + hc if hc else ""] if x)
        print("### %s\n\n%s\n" % (f.name, (body or section(t, "Delivered", "Accomplishments", "What was built") or cap(t, 20)).strip()))
    if not files: print("No SUMMARY.md files in phase %s yet." % p["prefix"])

# ---------- iterations / quick ----------
def iter_file(p): return p["dir"] / (p["prefix"] + "-ITERATIONS.md")
def iter_log(p, text):
    f = iter_start(p)
    f.write_text(read(f).rstrip("\n") + "\n- %s — %s\n" % (datetime.now().strftime("%H:%M"), text), encoding="utf-8")
    snapshot(f.parent, p["prefix"])

def snapshot(cwd, prefix):
    """Iterate mode deliberately makes no commits, so a whole session lives in the worktree.
    Park a recoverable snapshot in refs/gsdf/ — not a commit on any branch, invisible to
    git log and git status, and restorable with `git stash apply <ref>`."""
    import subprocess
    try:
        h = subprocess.run(["git", "stash", "create"], cwd=cwd, capture_output=True, text=True, timeout=15)
        sha = h.stdout.strip()
        if h.returncode == 0 and sha:
            subprocess.run(["git", "update-ref", "refs/gsdf/iter/%s/%s" % (prefix, sha[:8]), sha],
                           cwd=cwd, capture_output=True, timeout=15)
    except Exception:
        pass                                    # never let a snapshot failure break a log call
def iter_start(p):
    """Create NN-ITERATIONS.md with no entries. Logging a placeholder line to create the file
    would count as a change, inflating approve's tally and the every-10 reminder."""
    f = iter_file(p)
    if not f.exists():
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text("---\nphase: %s\nstatus: open\nstarted: %s\napproved: \n---\n# Iterations — Phase %s\n\n"
                     % (p["prefix"], datetime.now().strftime("%Y-%m-%dT%H:%M"), p["prefix"]), encoding="utf-8")
    return f

def iter_approve(p):
    f = iter_file(p)
    if not f.exists(): iter_start(p)
    s = re.sub(r"^status:.*$", "status: approved", read(f), count=1, flags=re.M)
    f.write_text(re.sub(r"^approved:.*$", "approved: " + datetime.now().strftime("%Y-%m-%dT%H:%M"), s, count=1, flags=re.M), encoding="utf-8")
    return f

def iter_lines(p):
    f = iter_file(p)
    return [l for l in read(f).splitlines() if l.startswith("- ")] if f.exists() else []

# ---------- init / adopt ----------
def templates():
    here = Path(__file__).resolve().parent
    for c in [here / "../skills/gsdf-templates", here / "../.claude/skills/gsdf-templates",
              Path.cwd() / ".claude/skills/gsdf-templates", Path.home() / ".claude/skills/gsdf-templates"]:
        if c.is_dir(): return c.resolve()
    return None
def npm_scripts(d):
    try: return json.loads(read(Path(d) / "package.json") or "{}").get("scripts") or {}
    except (json.JSONDecodeError, AttributeError): return {}
def detect(root):
    cfg = {"verify": {}, "phases_per_milestone": 4, "research": "auto"}
    cm = read(root / "CMakeLists.txt")
    m = re.search(r"project\s*\(\s*([A-Za-z0-9_\-]+)", cm)
    name = m.group(1) if m else "<Plugin>"
    if cm:
        cfg["verify"].update(build="cmake --build build --config Release", test="ctest --test-dir build --output-on-failure")
        cfg["standalone_target"] = name + "_Standalone"
    ui = next((d for d in ("ui", "Source/ui", "web") if (root / d / "package.json").exists()), None)
    sc = {}
    if ui:
        sc = npm_scripts(root / ui)
        cfg["ui_dir"] = ui
        # "test" is the convention, but a UI that is tested through a named script
        # (test:ui, test:e2e) is otherwise silently recorded as having no tests.
        t = next((k for k in ("test", "test:ui", "test:e2e", "test:unit") if k in sc), None)
        if t: cfg["verify"]["ui"] = "cd %s && npm run %s" % (ui, t)
        if "dev" in sc: cfg["verify"]["ui_dev"] = "cd %s && npm run dev" % ui
    # rebuild = what makes the thing the user tests current. A WebView plugin bundles its UI,
    # so the UI build comes first; a missing build/ is configured rather than failed on.
    uib = ui and "build" in sc
    if cm:
        cfg["rebuild"] = ("(cd %s && npm run build) && " % ui if uib else "") + \
            "{ [ -d build ] || cmake -B build -DCMAKE_BUILD_TYPE=Release; } && cmake --build build --config Release"
    elif "build" in npm_scripts(root):
        cfg["rebuild"] = "npm run build"
    elif uib:
        cfg["rebuild"] = "cd %s && npm run build" % ui
    # A repo that ships its own validator knows more than a guess does: sinemill's
    # scripts/validate.sh already does universal-binary + pluginval + auval, and
    # fetches pluginval itself. Prefer it, and write NOTHING rather than a
    # placeholder string -- a placeholder is a command `gsdf verify` will try to
    # run, which fails confusingly instead of being honestly absent.
    if (root / "scripts" / "validate.sh").exists():
        cfg["verify"]["plugin_validate"] = "bash scripts/validate.sh"
        cfg["verify"]["plugin_release"] = "bash scripts/validate.sh --release --strict build-release"
    elif shutil.which("pluginval"):
        cfg["verify"]["plugin_validate"] = ("pluginval --strictness-level 5 --validate "
                                            "build/%s_artefacts/Release/VST3/%s.vst3" % (name, name))
    return cfg
def merge(dst, src):
    for k, v in src.items():
        if isinstance(v, dict) and isinstance(dst.get(k), dict): merge(dst[k], v)
        elif k not in dst or dst.get(k) in ("", None): dst[k] = v
    return dst
def phase_files(pl, p):
    """Paths this phase actually touched, from its own commits and iteration log.

    Executors commit as `type(NN-MM): task`, so the phase's commits are findable by
    prefix; iterate logs carry `[path, path]` suffixes. Used to decide whether a gate
    is relevant at all -- running a plugin validator after a phase that only touched
    the UI is ceremony, and ceremony is what gets switched off.
    """
    out = set()
    pre = re.escape(p["prefix"])
    try:
        log = subprocess.run(["git", "log", "--name-only", "--format=%s",
                              r"--grep=^\w+(%s-[0-9]+)" % pre, "-E", "-200"],
                             capture_output=True, text=True, cwd=pl.parent).stdout
        for line in log.splitlines():
            line = line.strip()
            if line and "/" in line and not line.endswith(":"):
                out.add(line)
    except OSError:
        pass
    # A phase that has never been planned has no directory, and iter_file() would
    # divide None by a string. Verify must still run there — an unplanned phase is a
    # normal state, not an error.
    for l in (iter_lines(p) if p.get("dir") else []):
        m = re.search(r"\[([^\]]+)\]\s*$", l)
        if m:
            # Expand brace groups before splitting on commas, or "source/X.{h,cpp}"
            # becomes the two non-paths "source/X.{h" and "cpp}".
            for part in re.split(r",(?![^{]*\})", m.group(1)):
                part = part.strip()
                b = re.match(r"(.*)\{([^}]*)\}(.*)$", part)
                if b:
                    out.update("%s%s%s" % (b.group(1), x.strip(), b.group(3))
                               for x in b.group(2).split(","))
                elif "/" in part:
                    out.add(part)
    return sorted(out)


# ParameterID { <id>, <version> } with either side a literal OR a named constant. Tonn writes
# ParameterID { tonalCentre, kVersion } against `inline constexpr const char* tonalCentre =
# "tonalCentre"`; a literal-only pattern found zero parameters there and locked an empty ABI.
PARAM_RE = re.compile(r'ParameterID\s*[{(]\s*("[^"]*"|[A-Za-z_][\w:]*)\s*,\s*(\d+|[A-Za-z_][\w:]*)\s*[})]')
STR_CONST = re.compile(r'\b(?:constexpr|const)\b[^;=\n]*?\b([A-Za-z_]\w*)\s*(?:\[\])?\s*(?:=|\{)\s*(?:juce::String\s*\(\s*)?"([^"]*)"')
INT_CONST = re.compile(r'\b(?:constexpr|const)\b[^;=\n]*?\bint\s+([A-Za-z_]\w*)\s*(?:=|\{)\s*(\d+)')
# Never another codebase's parameters. alive_medium vendors JUCE under plugin/JUCE, and its
# example plugins put `gain`, `delay` and `uniqueID` into that project's lock.
VENDORED = {"juce", "third_party", "thirdparty", "external", "extern", "vendor", "vendored",
            "deps", "libs", "lib", "node_modules", "examples", "modules", "submodules", ".git"}

def param_sources(root):
    """C++ sources this project owns. Tracked files when it is a git repo -- that also drops
    submodules, which ls-files lists only as a gitlink -- else a walk; vendored trees skipped."""
    exts = (".cpp", ".h", ".hpp", ".cc", ".mm")
    try:
        r = subprocess.run(["git", "ls-files", "-z", "--", "*.cpp", "*.h", "*.hpp", "*.cc", "*.mm"],
                           cwd=root, capture_output=True, text=True, timeout=30)
        files = [root / x for x in r.stdout.split("\0") if x] if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        files = None
    if files is None:
        files = []
        # iterdir, not root / name: on a case-insensitive disk "Source" exists when "source"
        # does, and the path would carry the wrong case into every message
        for d in sorted(root.iterdir()):
            if d.is_dir() and d.name.lower() in ("source", "src", "plugin", "dsp"):
                files += [f for f in d.rglob("*") if f.suffix in exts]
    out, seen = [], set()
    for f in sorted(files):
        rel = f.relative_to(root).parts
        if any(x.lower() in VENDORED or x.lower().startswith(("build", "cmake-build")) for x in rel[:-1]):
            continue
        if f.suffix not in exts or not f.is_file(): continue
        # De-duplicate by INODE: macOS is case-insensitive, so "source" and "Source" are one
        # directory but two path strings, and a path-keyed set scanned it twice.
        st = f.stat()
        if (st.st_dev, st.st_ino) in seen: continue
        seen.add((st.st_dev, st.st_ino)); out.append(f)
    return out

def strip_comments(t):
    """Drop comments, keep line numbers, and leave string literals alone -- a doc comment that
    shows `ParameterID { id, kVersion }` is not a parameter, and "https://" is not a comment."""
    return re.sub(r'"(?:\\.|[^"\\\n])*"|//[^\n]*|/\*.*?\*/',
                  lambda m: m.group(0) if m.group(0)[0] == '"' else "\n" * m.group(0).count("\n"), t, flags=re.S)

def scan_params(root):
    """Every juce::ParameterID in declaration order, as ([(id, version), ...], [unresolved]).

    `unresolved` names each ParameterID whose id could not be read statically -- an id built at
    runtime, `"s" + std::to_string (n) + "_alive"`, is invisible to any scan. Reporting those is
    what stops a lock of 0 (or of a few stray ids) from passing for the real contract."""
    texts = [(f, strip_comments(read(f))) for f in param_sources(root)]
    strs, ints = {}, {}
    for _, t in texts:
        for m in STR_CONST.finditer(t): strs.setdefault(m.group(1), m.group(2))
        for m in INT_CONST.finditer(t): ints.setdefault(m.group(1), int(m.group(2)))
    out, unresolved = [], []
    for f, t in texts:
        for at in re.finditer(r"\bParameterID\s*[{(]", t):
            m = PARAM_RE.match(t, at.start())
            if not m:
                # ParameterID { juce::String (id), kHint } -- an id that only exists at runtime
                unresolved.append("%s:%d %s" % (f.relative_to(root), t[:at.start()].count("\n") + 1,
                                                re.sub(r"\s+", " ", t[at.start():at.start() + 70]).split(";")[0]))
                continue
            i, v = m.group(1), m.group(2)
            pid = i[1:-1] if i.startswith('"') else strs.get(i.split("::")[-1])
            ver = int(v) if v.isdigit() else ints.get(v.split("::")[-1])
            if pid is None or ver is None:
                unresolved.append("%s:%d %s" % (f.relative_to(root), t[:m.start()].count("\n") + 1,
                                                re.sub(r"\s+", " ", m.group(0))))
            else:
                out.append((pid, ver))
    return out, unresolved

def params_from_cmd(pl, cmd):
    """config.json `params_cmd`: a command printing the real layout, one `id [version]` per line.
    The only honest source for ids that exist only at runtime -- a test binary that walks the
    processor's AudioProcessorValueTreeState can print exactly what a host sees."""
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, cwd=pl.parent)
    if r.returncode: die("params_cmd failed (exit %d): %s" % (r.returncode, ((r.stdout + r.stderr).strip().splitlines() or [""])[-1][:160]))
    out = []
    for l in r.stdout.splitlines():
        w = l.split()
        if not w or w[0].startswith("#"): continue
        out.append((w[0], int(w[1]) if len(w) > 1 and w[1].isdigit() else 1))
    return out

def cmd_params(pl, p, write=False):
    """Guard the parameter ABI: order is the contract, and removal is forever.

    The vault lesson this mechanises: parameter ORDER is an ABI, so reordering or
    removing one silently repoints every automation lane in every saved session --
    and the damage arrives months later, in someone else's project, looking like
    anything but a rename. Retired ids must never be reused either.

    Off until a release exists (`abi_frozen: true` in config.json): before you ship,
    churn is exactly what you want.
    """
    root, cfg = pl.parent, config(pl)
    lock_f = pl / "params.lock"
    if cfg.get("params_cmd"):
        cur, unresolved, src = params_from_cmd(pl, cfg["params_cmd"]), [], "params_cmd"
    else:
        (cur, unresolved), src = scan_params(root), "source scan"
    if unresolved:
        # A partial lock is worse than none: it passes while guarding a fraction of the contract.
        print("cannot read every parameter id statically — %d ParameterID(s) are built at runtime:" % len(unresolved))
        for u in unresolved[:5]: print("  " + u)
        if len(unresolved) > 5: print("  … and %d more" % (len(unresolved) - 5))
        print("Set `params_cmd` in config.json to a command that prints the real layout, one\n"
              "`id version` per line (e.g. a test binary that walks the APVTS). Nothing written.")
        return 1
    if not cur:
        print("no juce::ParameterID found (%s) — nothing to guard. Nothing written.\n"
              "If the plugin has parameters, set `params_cmd` in config.json." % src)
        return 0 if not lock_f.exists() else 1
    dup = sorted({i for i, _ in cur if [x for x, _ in cur].count(i) > 1})
    if dup: print("warning: id declared more than once: %s" % ", ".join(dup))
    if write:
        lock_f.write_text(json.dumps([{"id": i, "version": v} for i, v in cur], indent=1) + "\n")
        print("wrote %s — %d parameter(s) from %s" % (lock_f, len(cur), src))
        return 0
    if not lock_f.exists():
        # Reading never writes. It used to create the lock on first call, silently, from
        # whatever the scan happened to find -- including nothing.
        print("%d parameter(s) from %s, no params.lock yet: %s\n`gsdf params --write` locks them."
              % (len(cur), src, ", ".join(i for i, _ in cur[:12]) + (" …" if len(cur) > 12 else "")))
        return 0
    if read(lock_f).strip() in ("[]", ""):
        # Older gsdf wrote the lock on first read from whatever it found -- often nothing.
        print("params.lock is empty, but %d parameter(s) exist — it guards nothing.\n"
              "`gsdf params --write` locks them." % len(cur))
        return 1 if cfg.get("abi_frozen") else 0
    if not cfg.get("abi_frozen"):
        print("abi_frozen is not set in config.json — %d parameter(s), not enforced.\n"
              "Set it when the first release ships; before that, churn is fine." % len(cur))
        return 0
    # params.lock is a file humans edit when they migrate deliberately, so a malformed one
    # is a normal accident, not a programming error: one line, not a crash.
    try:
        old = [(x["id"], x["version"]) for x in json.loads(read(lock_f))]
    except (json.JSONDecodeError, TypeError, KeyError) as e:
        die("%s is not a valid parameter lock (%s) — re-lock with `gsdf params --write`" % (lock_f, e))
    oi, ci = [i for i, _ in old], [i for i, _ in cur]
    bad = []
    for i in oi:
        if i not in ci:
            bad.append("REMOVED  %s — every saved session's automation for it is orphaned" % i)
    common_old = [i for i in oi if i in ci]
    common_new = [i for i in ci if i in oi]
    if common_old != common_new:
        bad.append("REORDERED — was %s, now %s. Order is the ABI: hosts address parameters "
                   "by index, so this repoints existing automation lanes." % (common_old, common_new))
    for i in ci:
        if i not in oi:
            hit = subprocess.run(["git", "log", "-p", "-S", '"%s"' % i, "--oneline", "-1"],
                                 capture_output=True, text=True, cwd=root).stdout.strip()
            if hit and i not in oi:
                bad.append("REUSED   %s appeared in history before — a retired id must never "
                           "come back with a new meaning (%s)" % (i, hit.splitlines()[0][:60]))
    if bad:
        print("parameter ABI broken:")
        for b in bad: print("  " + b)
        print("\nIf this is deliberate, migrate on load and re-lock with `gsdf params --write`.")
        return 1
    print("parameter ABI intact — %d parameter(s), order and ids unchanged" % len(cur))
    return 0


def verify_cmds(txt):
    """The shell commands in a plan's <verify> blocks. GSD-era plans nest one or more
    `<automated>` elements inside <verify>; handing the whole block to /bin/sh ran the tags
    as shell syntax, so every command exited 2 and verify reported 0/N with no real signal."""
    out = []
    for m in re.finditer(r"<verify>(.*?)</verify>", txt, re.S):
        body = m.group(1)
        auto = re.findall(r"<automated>(.*?)</automated>", body, re.S)
        if auto: out.extend(a.strip() for a in auto if a.strip())
        elif body.strip() and not re.search(r"</?[a-z_]+>", body): out.append(body.strip())
        # any other tagged body is prose or a manual check -- not something to run
    return out

def cmd_verify(pl, p):
    """Run the phase's verification and report honestly. Exit non-zero on failure.

    This lives here rather than in approve.md because it is a CHECK, and a check
    written as prompt text is a check that can be forgotten. The bug it exists to
    stop is specific: approve used to print "Verified: build OK test OK" from a
    template, whether or not any command ran -- and a project whose config.json
    has no verify block looked exactly like one that passed.
    """
    cfg = config(pl)
    v = cfg.get("verify") or {}
    # plugin_release is the milestone gate, not a per-phase one: it is a full
    # Release build plus auval. Left out here deliberately.
    keys = ["build", "test", "ui"]
    # Only validate the plugin when the phase touched something that could change
    # how the host sees it. A UI-only phase does not need a 30s host validator, and
    # a gate that runs when it cannot possibly fail is the kind people disable.
    touched = phase_files(pl, p)
    src = re.compile(r"^(source|Source|src|dsp|plugin)/")
    if any(src.match(f) and not f.startswith(("ui/", "Source/ui/")) for f in touched) or not touched:
        keys.append("plugin_validate")
    # A verify entry must be a shell string. A hand-edited config.json holding a list or a
    # number reached subprocess.run() and crashed; worse, skipping it silently would report
    # a phase as verified by fewer commands than its config claims.
    bogus = [k for k in keys if k in v and not isinstance(v[k], str)]
    for k in bogus:
        print("ignoring verify.%s — expected a shell string, got %s" % (k, type(v[k]).__name__))
    cmds = [(k, v[k]) for k in keys
            if v.get(k) and isinstance(v[k], str) and not v[k].startswith("<")]
    src = "config.json"
    if not cmds:
        # Fall back to the plans' own <verify> commands: a phase can be provably
        # green without a project-level build, and silence would misreport that.
        seen, pv = set(), []
        for pl_ in plans_of(p["dir"], p["prefix"]):
            for c in verify_cmds(read(Path(pl_["file"]))):
                if c not in seen:
                    seen.add(c); pv.append(("plan %s" % pl_["id"], c))
        cmds, src = pv, "plan <verify> blocks"
    if not cmds:
        print("NONE CONFIGURED — no `verify` in config.json and no <verify> in any plan.\n"
              "Nothing can be proven about phase %s. Add verify.build / verify.test, or run `gsdf init`." % p["prefix"])
        return 2
    print("verify %s — %d command(s) from %s" % (p["prefix"], len(cmds), src))
    bad = 0
    for name, c in cmds:
        r = subprocess.run(c, shell=True, capture_output=True, text=True)
        tail = [l for l in (r.stdout + r.stderr).splitlines() if l.strip()][-1:] or [""]
        print("  %-22s exit %d  %s" % (name, r.returncode, tail[0][:100]))
        if r.returncode: bad += 1
    print("verify: %d/%d passed" % (len(cmds) - bad, len(cmds)))
    return 1 if bad else 0


# ---------- settings / rebuild ----------
# How GSDF behaves for this project. One table so `gsdf cfg`, new-project's questions and the
# command docs cannot drift apart: a setting that is not here does not exist. Every default is
# on, auto included: a project that skipped the questions, or predates them, gets the full mode.
SETTINGS = [
    ("auto", "bool", True, "work on its own: discuss up front, stop only at the mockups, build the rest"),
    ("plain_language", "bool", True, "talk to the user as a non-programmer; never ask technical questions"),
    ("phases_per_milestone", "int", 4, "how many phases a roadmap aims for"),
    ("ui_first", "bool", True, "a project with a UI starts with a mockup phase"),
    ("ui_style", "str", "gsdf", "UI look when the project names none (gsdf = GSDF Style Guide by Daftsins)"),
    ("research", "auto|always|never", "auto", "when the planner searches the web"),
    ("commit_docs", "bool", True, "commit .planning/ files as they are written"),
    ("rebuild", "str", "", "rebuilds AND installs the product; runs before every 'try it'"),
]
SET = {k: (t, d, h) for k, t, d, h in SETTINGS}
def onoff(v): return "on" if v else "off"
def setting(pl, k):
    """A setting's effective value: config.json's when it is there and well-typed, else the
    default. `rebuild` falls back to what detect() would write, so a project adopted before
    the key existed still rebuilds rather than telling the user to run a command."""
    t, d, _ = SET[k]; v = config(pl).get(k)
    if k == "rebuild" and not (isinstance(v, str) and v.strip()):
        return detect(pl.parent).get("rebuild", "")
    if t == "bool": return v if isinstance(v, bool) else d
    if t == "int": return v if isinstance(v, int) and not isinstance(v, bool) and v > 0 else d
    if "|" in t: return v if v in t.split("|") else d
    return v if isinstance(v, str) else d
def show(t, v): return onoff(v) if t == "bool" else (str(v) if v != "" else "(none)")
def parse_setting(k, raw):
    t = SET[k][0]; r = raw.strip()
    if t == "bool":
        if r.lower() in ("on", "true", "yes", "1"): return True
        if r.lower() in ("off", "false", "no", "0"): return False
        die("%s is on or off, not %r" % (k, raw))
    if t == "int":
        if not r.isdigit() or int(r) < 1: die("%s is a whole number of 1 or more, not %r" % (k, raw))
        return int(r)
    if "|" in t and r not in t.split("|"): die("%s is one of %s, not %r" % (k, t.replace("|", ", "), raw))
    return r
def cmd_cfg(pl, a):
    if not a:
        for k, t, d, h in SETTINGS:
            v = setting(pl, k)
            shown = ("set" if v else "(none)") if k == "rebuild" else show(t, v)
            print("%-21s %-8s %s%s" % (k, shown, h, "" if v == d or k == "rebuild" else "   [default %s]" % show(t, d)))
        r = setting(pl, "rebuild")
        if r: print("\nrebuild: %s" % r)
        return print("\nChange one: gsdf cfg <setting> <value>")
    k = a[0]
    if k not in SET: die("unknown setting: %s (one of: %s)" % (k, ", ".join(SET)))
    if len(a) == 1: return print(show(SET[k][0], setting(pl, k)))
    v = parse_setting(k, " ".join(a[1:]))
    with locked(pl):
        cfg = config(pl, strict=True); cfg[k] = v
        (pl / "config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    print("%s = %s" % (k, show(SET[k][0], v)))
def cmd_rebuild(pl):
    """Rebuild and install, so 'try it' is never preceded by 'first run this'. Output is
    captured: a JUCE build prints thousands of lines, and an agent pays for every one."""
    root = pl.parent; c = setting(pl, "rebuild")
    if not c: die("nothing to rebuild with — no CMakeLists.txt or npm build script found.\n"
                  "Set one: gsdf cfg rebuild \"<command that builds and installs>\"")
    cm = read(root / "CMakeLists.txt")
    if re.search(r"juce_add_plugin", cm) and not re.search(r"COPY_PLUGIN_AFTER_BUILD\s+TRUE", cm, re.I):
        print("warning: juce_add_plugin without COPY_PLUGIN_AFTER_BUILD TRUE — this builds the plugin\n"
              "         but does not install it. Add that flag, or add an install step to `rebuild`.")
    t0 = datetime.now()
    r = subprocess.run(c, shell=True, cwd=root, capture_output=True, text=True)
    secs = (datetime.now() - t0).seconds
    if r.returncode:
        tail = [l for l in (r.stdout + r.stderr).splitlines() if l.strip()][-15:]
        if tail: print("\n".join(tail))
        print("rebuild FAILED (exit %d, %ds): %s" % (r.returncode, secs, c))
        return 1
    print("rebuilt and installed (%ds): %s" % (secs, c))
    return 0


def cmd_findings(pl, p):
    """Print what this phase captured as reusable, for approve to collate.

    Two sources, both written at the moment the lesson was learned: iteration
    lines prefixed FINDING:, and `## Findings` sections in plan summaries.
    Nothing here judges -- judging later, from a record written for another
    purpose, is exactly what the findings format exists to avoid.
    """
    out = []
    for l in iter_lines(p):
        # Lines are "- HH:MM — FINDING: ...", so anchoring on ^FINDING: matches
        # nothing. Match the prefix anywhere after the timestamp.
        m = re.search(r"FINDING:\s*(.+)$", l)
        if m: out.append(("iterate", m.group(1).strip()))
    for x in plans_of(p["dir"], p["prefix"]):
        txt = read(Path(x["file"]).with_name(Path(x["file"]).name.replace("-PLAN.md", "-SUMMARY.md")))
        m = re.search(r"^## Findings\s*$(.*?)(?=^## |\Z)", txt, re.S | re.M)
        if m:
            for line in m.group(1).splitlines():
                if line.strip().startswith("- "): out.append(("plan %s" % x["id"], line.strip()[2:]))
    if not out:
        print("no findings captured in phase %s — normal; nothing reusable is a real answer" % p["prefix"])
        return 0
    for where, text in out: print("[%s] %s" % (where, text))
    return 0


def cmd_adopt(pl):
    (pl / "config.json").write_text(json.dumps(merge(config(pl, strict=True), detect(pl.parent)), indent=2) + "\n", encoding="utf-8")
    print("Adopted %s" % pl); cmd_list(pl); print(); cmd_next(pl)
def cmd_init(name):
    root = Path.cwd(); pl = root / ".planning"
    if pl.is_dir(): die(".planning/ already exists — run `gsdf adopt`")
    t = templates() or die("templates not found (looked for .claude/skills/gsdf-templates)")
    (pl / "phases").mkdir(parents=True); (pl / "quick").mkdir()
    sub = {"{{NAME}}": name, "{{DATE}}": date.today().isoformat(), "{{MILESTONE}}": "v1.0"}
    for dst in ("PROJECT.md", "ROADMAP.md", "STATE.md"):
        s = read(t / dst.replace(".md", ".template.md"))
        for k, v in sub.items(): s = s.replace(k, v)
        (pl / dst).write_text(s, encoding="utf-8")
    (pl / "config.json").write_text(json.dumps(detect(root), indent=2) + "\n", encoding="utf-8")
    print("Initialised %s for %s" % (pl, name))

# ---------- output commands ----------
def cmd_next(pl):
    if not pl: return print("new-project")
    ph = phases(pl)
    if not ph:
        # No roadmap phases and no phase directories. That is an unstarted or unparseable
        # project, never a finished milestone — saying milestone-done here would invite
        # progress --next to archive and tag a project that has done nothing.
        return print("new-project")
    p = current(pl, ph, warn=True)
    print("milestone-done" if not p else "%s %s" % (p["status"], p["prefix"]))
def cmd_list(pl):
    print("| NN | slug | status | plans | done | iterations |\n|---|---|---|---|---|---|")
    for p in phases(pl):
        pls = plans_of(p["dir"], p["prefix"])
        print("| %s | %s | %s | %d | %d | %d |" % (p["prefix"], p["slug"], p["status"], len(pls),
              sum(1 for x in pls if x["has_summary"]), len(iter_lines(p)) if p["dir"] else 0))
def cmd_advance(pl, p=None):
    """Advance an EXPLICIT phase. Defaulting to current() is a trap: approve stamps the
    phase's ITERATIONS approved first, so by the time advance runs, current() has already
    moved on and advance would mark the NEXT, unstarted phase complete."""
    p = p or current(pl) or die("every phase is already complete")
    if not p["dir"]: new_dir(pl, p)
    iter_approve(p)
    t = read(pl / "ROADMAP.md"); orig = t
    # Same padding tolerance as roadmap_entry, and for the same reason: without it an inserted
    # phase's checkbox stayed [ ] and its Status stayed pending through approve, and the whole
    # update fell through to the trailing HTML comment below.
    t = re.sub(r"^([ \t]*[-*][ \t]*)\[[ ]\]([ \t]*\**Phase[ \t]+%s)" % phase_num_re(p["num"]), r"\1[x]\2", t, count=1, flags=re.M)
    blk = re.search(r"^#{2,4}[ \t]*\*{0,2}Phase[ \t]+%s.*?(?=^#{2,4}[ \t]|\Z)" % phase_num_re(p["num"]), t, re.M | re.S)
    if blk:
        nb = re.sub(r"(\*{0,2}Status\*{0,2}:[ \t]*)(pending|in progress|planned|todo)", r"\1complete", blk.group(0), flags=re.I)
        nb = nb.replace("⏳", "✅"); t = t[:blk.start()] + nb + t[blk.end():]
    if t == orig: t = t.rstrip("\n") + "\n\n<!-- gsdf: phase %s complete -->\n" % p["prefix"]
    (pl / "ROADMAP.md").write_text(t, encoding="utf-8")
    nxt = next((x for x in phases(pl) if key(x["num"]) > key(p["num"]) and x["status"] != "complete"), None) or current(pl)
    state_set(pl, "phase", nxt["prefix"] if nxt else p["prefix"])
    state_sync(pl, nxt)
    print("Phase %s complete. Next: %s" % (p["prefix"], (nxt["prefix"] + " " + nxt["slug"]) if nxt else "milestone-done"))
def cmd_quick_new(pl, s):
    q = pl / "quick"; q.mkdir(exist_ok=True)
    n = max([int(m.group(1)) for d in q.glob("*") if d.is_dir() and (m := re.match(r"^(\d+)-", d.name))] or [0]) + 1
    d = q / ("%03d-%s" % (n, slug(s))); d.mkdir(); print(d)

# ---------- update ----------
REPO   = os.environ.get("GSDF_REPO", "https://github.com/daftsins-star/gsdf.git")
BRANCH = os.environ.get("GSDF_BRANCH", "main")

def install_root():
    """The .claude/ this CLI was installed into, or None when it runs from a source checkout."""
    b = Path(__file__).resolve().parent
    return b.parent if b.name == "bin" and (b.parent / "commands" / "gsdf").is_dir() else None
def update_dest():
    """The install `gsdf update` acts on, and therefore where the receipt lives.

    A CLI run straight out of a source checkout (`./bin/gsdf`) belongs to no install, so
    it targets the global one. Deriving the receipt path from __file__ instead would drop
    an untracked file in the repo AND leave the install it actually updated holding a
    stale receipt -- which is the one thing the receipt exists to prevent."""
    return install_root() or (Path.home() / ".claude")
def receipt_file(): return update_dest() / "bin" / "gsdf-install.json"
def receipt():
    """Written at install time beside the installed CLI: which commit it came from.

    Without it only the version STRING can be compared, and a project that ships
    from main without tagging moves far more often than it bumps VERSION."""
    try: return json.loads(read(receipt_file()) or "{}")
    except json.JSONDecodeError: return {}
def vtuple(s): return tuple(int(x) for x in re.findall(r"\d+", s or "")) or (0,)
def raw_url(path, ref=None):
    m = re.search(r"github\.com[:/]+([^/]+?)/([^/]+?)(?:\.git)?/?$", REPO)
    return m and "https://raw.githubusercontent.com/%s/%s/%s/%s" % (m.group(1), m.group(2), ref or BRANCH, path)
def remote_tags():
    """Release tags on the remote, newest first. `git ls-remote` needs no clone and no token.

    Tracking tags rather than the branch is what makes VERSION mean anything: a release
    bumps it, and an update moves between releases instead of onto whatever is mid-work
    on main."""
    try:
        # Deliberately NOT --refs: that strips the peeled "refs/tags/X^{}" line, and for an
        # ANNOTATED tag the plain line is the tag OBJECT's sha, not the commit's. Comparing
        # that against a receipt (which holds a commit) never matches, so every check would
        # report "the ref has moved" forever and offer an update that changes nothing.
        r = subprocess.run(["git", "ls-remote", "--tags", REPO],
                           capture_output=True, text=True, timeout=30)
        if r.returncode: return []
    except (OSError, subprocess.SubprocessError): return []
    sha = {}
    for line in r.stdout.splitlines():
        p = line.split()
        if len(p) != 2: continue
        name, peeled = p[1].rsplit("/", 1)[-1], p[1].endswith("^{}")
        name = name[:-3] if peeled else name
        if not re.match(r"^v?\d+(\.\d+)*$", name): continue
        if peeled or name not in sha: sha[name] = p[0]   # the peeled commit always wins
    return sorted(((vtuple(n), n, s) for n, s in sha.items()), reverse=True)
def remote_version(ref=None):
    import urllib.request
    u = raw_url("bin/gsdf", ref) or die("GSDF_REPO is not a GitHub URL: %s" % REPO)
    try:
        with urllib.request.urlopen(u, timeout=20) as r: src = r.read().decode("utf-8", "replace")
    except Exception as e:
        die("could not reach GitHub (%s) — check the network, or set GSDF_REPO/GSDF_BRANCH" % e)
    m = re.search(r'^VERSION\s*=\s*"([^"]+)"', src, re.M)
    return m.group(1) if m else die("no VERSION in %s — is that a GSDF checkout?" % u)
def remote_head(ref=None):
    try:
        r = subprocess.run(["git", "ls-remote", REPO, ref or BRANCH], capture_output=True, text=True, timeout=30)
        return r.stdout.split()[0] if r.returncode == 0 and r.stdout.split() else None
    except (OSError, subprocess.SubprocessError): return None
def source_checkout():
    """A GSDF working copy at or above cwd. Updating there installs GitHub's copy over
    whatever is being developed locally, so it is worth refusing to do it silently."""
    for c in [Path.cwd().resolve(), *Path.cwd().resolve().parents]:
        if all((c / x).exists() for x in ("bin/gsdf", "install.sh", "GSDF-SPEC.md")): return c
    return None

def cmd_update(check=False, force=False, track_main=False):
    """Compare this install against GitHub, and reinstall from it when it is behind.

    Follows RELEASE TAGS when the remote has any, falling back to the branch when it
    does not. That is what gives VERSION meaning: a release bumps it, and an update
    lands on a release rather than on whatever is mid-work on main. `--main` opts back
    into branch tracking for anyone who wants the unreleased tip.

    Two signals, because one is not enough: VERSION catches a real release, and the
    install receipt's commit catches the ref moving without a version bump. Either is
    reason to offer an update; neither is acted on silently under --check.
    """
    r = receipt()
    here = r.get("commit")
    # Where this install came from decides what a commit mismatch MEANS. Installed from
    # GitHub, a different sha means behind. Installed from a local checkout, it usually
    # means ahead -- and "updating" would revert the build being developed.
    from_git = str(r.get("source", "")).startswith(("http", "git@", "ssh://"))
    tags = [] if track_main else remote_tags()
    ref, rsha = (tags[0][1], tags[0][2]) if tags else (BRANCH, remote_head())
    rv, dest = remote_version(ref), update_dest()
    print("installed  gsdf %-8s %s" % (VERSION, Path(__file__).resolve()))
    if install_root() is None:
        # Running from a checkout: the thing that gets replaced is the global install,
        # not this file. Saying so stops "update" looking like it edits the repo.
        print("targeting  %s  (this CLI runs from a source checkout)" % dest)
    print("on github  gsdf %-8s %s@%s%s" % (rv, REPO, ref, "  " + rsha[:8] if rsha else ""))
    if not tags and not track_main:
        print("           (no release tags on the remote — tracking the %s branch)" % BRANCH)
    newer, moved = vtuple(rv) > vtuple(VERSION), bool(rsha and here and rsha != here)

    if vtuple(rv) < vtuple(VERSION):
        print("\nthis install is NEWER than %s. Not touching it — `--force` installs %s anyway." % (ref, rv))
        if not force: return 0
    elif newer:   print("\nupdate available: %s -> %s" % (VERSION, rv))
    elif moved and not from_git:
        print("\nsame version, and %s is at a different commit (%s -> %s) — but this was installed\n"
              "from a local checkout (%s), so that is not evidence of being behind;\n"
              "it usually means ahead. `--force` installs GitHub's copy anyway." % (ref, here[:8], rsha[:8], r.get("source")))
        if not force: return 0
    elif moved:   print("\nsame version, but %s has moved since this was installed (%s -> %s)." % (ref, here[:8], rsha[:8]))
    elif force:   print("\nup to date — reinstalling anyway (--force).")
    else:
        print("\nup to date." + ("" if here else
              "\nNo install receipt, so only the version string could be compared."
              "\n`gsdf update --force` reinstalls and writes one."))
        return 0
    if check: return print("--check: nothing was written.") or 0

    sc = source_checkout()
    if sc and not force:
        dirty = subprocess.run(["git", "status", "--porcelain"], cwd=sc, capture_output=True, text=True).stdout.strip()
        head  = subprocess.run(["git", "rev-parse", "HEAD"], cwd=sc, capture_output=True, text=True).stdout.strip()
        if dirty or (rsha and head and head != rsha):
            die("refusing: %s is a GSDF checkout with %s.\n"
                "Updating copies GitHub over it, discarding the build installed from here.\n"
                "  ./install.sh --global   installs THIS tree\n"
                "  gsdf update --force     takes GitHub's"
                % (sc, "uncommitted changes" if dirty else "commits not on %s" % ref))

    tmp = tempfile.mkdtemp(prefix="gsdf-update-")
    try:
        r = subprocess.run(["git", "clone", "--quiet", "--depth", "1", "--branch", ref, REPO, tmp + "/src"],
                           capture_output=True, text=True, timeout=300)
        if r.returncode: die("clone failed: %s" % ((r.stderr.strip().splitlines() or [""])[-1]))
        src = Path(tmp) / "src"
        got = re.search(r'^VERSION\s*=\s*"([^"]+)"', read(src / "bin" / "gsdf"), re.M)
        # The raw file and the clone are two fetches of the same ref. If they disagree,
        # something moved mid-update; better to stop than to install a surprise.
        if not got or got.group(1) != rv:
            die("the clone says %s but %s advertised %s — refusing to install" % (got and got.group(1), ref, rv))
        root = install_root()
        args = ["--global"] if (root is None or root == Path.home() / ".claude") else [str(root.parent)]
        print()
        sys.stdout.flush()   # install.sh writes straight to the fd; unflushed prints land after it
        if subprocess.run(["bash", str(src / "install.sh")] + args).returncode:
            die("install.sh failed — nothing is half-written, it copies rather than patches")
        # Write the receipt HERE, not only in install.sh. The install.sh that just ran came
        # from the release being installed, so relying on it means any release that drops or
        # breaks the receipt leaves a stale one — and update then mis-reports for good.
        sha = subprocess.run(["git", "rev-parse", "HEAD"], cwd=src, capture_output=True, text=True).stdout.strip()
        receipt_file().write_text(json.dumps(
            {"version": rv, "commit": sha or (rsha or "unknown"), "source": REPO + "@" + ref,
             "installed": datetime.now().strftime("%Y-%m-%dT%H:%M:%SZ")}, indent=2) + "\n", encoding="utf-8")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    print("\nupdated to gsdf %s. Restart Claude Code to pick up the new commands." % rv)
    return 0

# ---------- bug log ----------
# Bugs in GSDF surface while using GSDF on real work, in some other project, mid-task --
# the worst possible moment to stop and file a report. So recording has to cost nearly
# nothing: crashes record themselves, and everything else is one line the agent can write
# without breaking stride. The log is global, because the bug is hit in your project and
# fixed in GSDF's.
BUGLOG = Path(os.environ.get("GSDF_BUGLOG", Path.home() / ".claude" / "gsdf-bugs.jsonl"))

def bug_record(kind, msg, where=""):
    """Append one JSON line. Never raises: failing to record a bug must not become one."""
    try:
        rec = {"t": datetime.now().strftime("%Y-%m-%d %H:%M"), "k": kind, "v": VERSION,
               "m": str(msg)[:400], "d": str(Path.cwd())[:200]}
        # for a report the argv IS the message; recording it twice just pads the file
        if kind != "report": rec["a"] = " ".join(sys.argv[1:])[:160]
        if where: rec["w"] = where
        BUGLOG.parent.mkdir(parents=True, exist_ok=True)
        with open(BUGLOG, "a", encoding="utf-8") as fh:
            fcntl.flock(fh, fcntl.LOCK_EX)
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
            fcntl.flock(fh, fcntl.LOCK_UN)
    except Exception:
        pass

def bug_frame(e):
    """innermost gsdf frame as 'func:line' -- the one thing that makes a crash fixable."""
    try:
        import traceback
        # Resolve BOTH sides. The traceback carries the path as invoked, and the usual
        # install is reached through a symlink (~/.local/bin/gsdf -> ~/.claude/bin/gsdf) --
        # and on macOS /var is itself a symlink to /private/var. Comparing a raw filename
        # against a resolved one silently matched nothing exactly where it matters most.
        me = Path(__file__).resolve()
        fr = [x for x in traceback.extract_tb(e.__traceback__) if Path(x.filename).resolve() == me]
        return "%s:%d" % (fr[-1].name, fr[-1].lineno) if fr else ""
    except Exception:
        return ""

def cmd_bug(text):
    if not text: die('usage: gsdf bug "<one line: what went wrong>"')
    bug_record("report", text)
    print("recorded. %s" % BUGLOG)

def bug_recs():
    recs = []
    for line in read(BUGLOG).splitlines():
        try: recs.append(json.loads(line))
        except json.JSONDecodeError: pass
    return recs
def bug_key(r):
    # crashes dedup by site + exception type; reports by their text
    return (r.get("w", "") + "|" + r.get("m", "").split(":")[0]) if r.get("k") == "crash" else r.get("m", "").strip().lower()
def bug_id(k):
    """Stable 4-hex id per group. A position in the listing would shift as reports arrive, and
    `--fixed 3` must never retire a different bug than the one that was read."""
    return hashlib.sha1(k.encode()).hexdigest()[:4]
def bug_groups(recs):
    groups = {}
    for r in recs:
        k = bug_key(r)
        g = groups.setdefault(k, {"id": bug_id(k), "n": 0, "r": r, "vs": set(), "last": ""})
        g["n"] += 1; g["vs"].add(r.get("v", "?")); g["last"] = max(g["last"], r.get("t", ""))
        if r.get("k") == "crash": g["r"] = r
    return groups

def cmd_bugs_count():
    """One line or nothing -- for a SessionStart hook in the GSDF repo, where the log would
    otherwise sit unread. Recording was always cheap; nothing made anyone look."""
    n = len(bug_groups(bug_recs()))
    if n: print("gsdf: %d open bug report(s) in %s — run `gsdf bugs`, fix with a regression test, "
                "then `gsdf bugs --fixed <id> \"<commit>\"`" % (n, BUGLOG))

def cmd_bugs_fixed(bid, note=""):
    """Retire ONE group to the archive, stamped with what fixed it. --clear was all-or-nothing,
    so fixed reports sat next to open ones until everything was done."""
    recs = bug_recs()
    hit = [r for r in recs if bug_id(bug_key(r)) == bid.lstrip("#")]
    if not hit: die("no open bug with id %s — `gsdf bugs` lists them" % bid)
    keep = [r for r in recs if r not in hit]
    stamp = {"fixed": datetime.now().strftime("%Y-%m-%d %H:%M"), "fixed_in": VERSION}
    if note: stamp["fix"] = note[:200]
    with open(BUGLOG.with_suffix(".archive.jsonl"), "a", encoding="utf-8") as fh:
        for r in hit: fh.write(json.dumps({**r, **stamp}, ensure_ascii=False) + "\n")
    with open(BUGLOG, "w", encoding="utf-8") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        fh.write("".join(json.dumps(r, ensure_ascii=False) + "\n" for r in keep))
        fcntl.flock(fh, fcntl.LOCK_UN)
    print("retired #%s (%d record(s)) — %d open" % (bid.lstrip("#"), len(hit), len(bug_groups(keep))))

def cmd_bugs(clear=False):
    """Group, count and print. Compact on purpose -- this output is read in a context window."""
    recs = bug_recs()
    if not recs:
        return print("no bugs recorded (%s)" % BUGLOG)
    if clear:
        arch = BUGLOG.with_suffix(".archive.jsonl")
        with open(arch, "a", encoding="utf-8") as fh: fh.write(read(BUGLOG))
        BUGLOG.write_text("")
        return print("archived %d record(s) -> %s" % (len(recs), arch))
    groups = bug_groups(recs)
    print("%d distinct, %d occurrence(s)   %s\n" % (len(groups), len(recs), BUGLOG))
    for g in sorted(groups.values(), key=lambda x: (-x["n"], x["last"])):
        r = g["r"]
        print("#%s [%dx] %-6s %s" % (g["id"], g["n"], r.get("k", "?"), r.get("m", "")))
        bits = [x for x in (r.get("w", ""), "gsdf " + r.get("a", "") if r.get("a") else "",
                            "v" + ",".join(sorted(g["vs"])), g["last"]) if x]
        print("      " + "  |  ".join(bits))
    print("\nFixed one: gsdf bugs --fixed <id> \"<commit>\"   (all: --clear)")

# ---------- trace ----------
# A real phase, run end to end, is the only thing that checks whether the COMMANDS do what
# their markdown says -- a static read cannot see that approve skipped its verify gate,
# because skipping it raises nothing. So record the call sequence during a deliberate run
# and check it afterwards. A sentinel file, not an env var: every agent Bash call is a fresh
# shell, and an exported variable would not survive between them.
TRACE_ON   = Path(os.environ.get("GSDF_TRACE_ON",   Path.home() / ".claude" / "gsdf-trace.on"))
TRACE_FILE = Path(os.environ.get("GSDF_TRACE_FILE", Path.home() / ".claude" / "gsdf-trace.jsonl"))

def trace_write(argv, code):
    if not TRACE_ON.exists(): return
    try:
        with open(TRACE_FILE, "a", encoding="utf-8") as fh:
            fcntl.flock(fh, fcntl.LOCK_EX)
            fh.write(json.dumps({"t": datetime.now().strftime("%H:%M:%S"), "a": argv[:8],
                                 "x": code, "d": Path.cwd().name}) + "\n")
            fcntl.flock(fh, fcntl.LOCK_UN)
    except Exception:
        pass

# Invariants a trace can settle that reading the markdown cannot. Each is (name, trigger,
# what must have come before it, why it matters).
TRACE_RULES = [
    ("approve ran its verify gate",  ("phase", "advance"), ("verify",),
     "a phase was advanced without gsdf verify -- approve.md step 1 was skipped"),
    ("approve collated findings",    ("phase", "advance"), ("findings",),
     "a phase was advanced without gsdf findings -- approve.md step 5 was skipped"),
    ("execute handed off with tryit",("iter", "start"),    ("tryit",),
     "iterate mode was entered without gsdf tryit -- execute.md step 4 was skipped"),
    ("rebuilt before the handoff",   ("iter", "start"),    ("rebuild",),
     "iterate mode was entered without gsdf rebuild -- the user would test a stale build"),
    ("plans were linted",            ("iter", "start"),    ("lint",),
     "a phase reached execute without gsdf lint -- plan.md step 3 was skipped"),
]

def cmd_trace(arg):
    if arg == "on":
        TRACE_ON.parent.mkdir(parents=True, exist_ok=True); TRACE_ON.write_text("")
        TRACE_FILE.write_text("")
        return print("trace on — %s\nRun the phase, then `gsdf trace show`." % TRACE_FILE)
    if arg == "off":
        TRACE_ON.unlink(missing_ok=True)
        return print("trace off (%s kept)" % TRACE_FILE)
    if arg not in ("show", "", None): die("usage: gsdf trace on|off|show")
    recs = []
    for line in read(TRACE_FILE).splitlines():
        try: recs.append(json.loads(line))
        except json.JSONDecodeError: pass
    if not recs: return print("no trace recorded — `gsdf trace on`, run a phase, come back")
    print("%d call(s)%s\n" % (len(recs), "   [recording]" if TRACE_ON.exists() else ""))
    for r in recs:
        mark = "  " if r.get("x") == 0 else " !"
        print("%s %s  %-34s exit %s  (%s)" % (mark, r.get("t"), " ".join(r.get("a", [])), r.get("x"), r.get("d")))
    seq = [r.get("a", []) for r in recs]
    print()
    for name, trig, need, why in TRACE_RULES:
        at = next((i for i, a in enumerate(seq) if a[:len(trig)] == list(trig)), None)
        if at is None: continue
        if any(a and a[0] in need for a in seq[:at]): print("  ok   %s" % name)
        else: print("  MISS %s\n       %s" % (name, why))
    fails = [r for r in recs if r.get("x")]
    if fails: print("\n%d call(s) exited non-zero — expected for a gate that fired, a bug otherwise." % len(fails))
    print("\nAnything wrong here: gsdf bug \"<one line>\"")

USAGE = {
    "init":      "gsdf init <name>              scaffold .planning/ here (writes)",
    "adopt":     "gsdf adopt                    fill config.json from the build it detects (writes)",
    "next":      "gsdf next                     the next step: plan|execute|iterate|blocked NN, or milestone-done",
    "state":     "gsdf state [set <k> <v>|note|defer|position \"<text>\"|sync]   read STATE.md; subcommands write",
    "phase":     "gsdf phase list|current|dir [N]|advance N   dir creates the directory; advance writes",
    "plans":     "gsdf plans [N]                plans of a phase, as JSON",
    "waves":     "gsdf waves [N]                execution waves, as JSON",
    "conflicts": "gsdf conflicts [N]            exit 1 if two plans in one wave write the same file",
    "lint":      "gsdf lint [N]                 plan gates; exit 1 naming the plan and the problem",
    "context":   "gsdf context [N]              the planner's briefing for a phase",
    "tryit":     "gsdf tryit [N]                what to try, from the phase's summaries",
    "iter":      "gsdf iter start|log|list|count|approve [N] [\"<text>\"]   log/start/approve write",
    "quick":     "gsdf quick [new <slug>]       list quick tasks, or create one (writes)",
    "verify":    "gsdf verify [N]               run the phase's checks; exit 0 pass / 1 fail / 2 nothing configured",
    "findings":  "gsdf findings [N]             FINDING: lines and summary ## Findings",
    "params":    "gsdf params [N] [--write]     parameter ABI guard; reads only, --write (re)locks params.lock",
    "cfg":       "gsdf cfg [<setting> [<value>]]  how GSDF behaves here; with a value, writes config.json",
    "rebuild":   "gsdf rebuild                  rebuild and install the product; quiet unless it fails",
    "update":    "gsdf update [--check] [--force] [--main]   compare with GitHub, reinstall when behind",
    "bug":       "gsdf bug \"<one line>\"        record a GSDF bug you just hit, then carry on",
    "bugs":      "gsdf bugs [--count] [--fixed <id> [note]] [--clear]   open bug reports; --fixed retires one",
    "trace":     "gsdf trace on|off|show        record a real run's call sequence and check it",
    "version":   "gsdf --version                version, install path, and open bug count",
}
def cmd_help(c=None):
    if c in USAGE: return print("usage: " + USAGE[c])
    print(__doc__.strip() + "\n")
    for v in USAGE.values(): print("  " + v)
    print("\nN defaults to the current phase. `gsdf <command> --help` for one command.")
    # Last line stays machine-readable: the conformance suite checks the docs against it.
    print("Subcommands: " + " ".join(k for k in USAGE if k != "version"))

def main(a):
    c = a[0] if a else "next"
    if c in ("-h", "--help", "help"): return cmd_help(a[1] if len(a) > 1 else None)
    # Help after ANY subcommand is a request for help, never an argument: `bug --help` filed a
    # bug reading "--help", and `init --help` scaffolded a project named "--help".
    if len(a) == 2 and a[1] in ("-h", "--help", "help"): return cmd_help(c)
    if c == "init":
        if len(a) < 2 or a[1].startswith("-"): die("usage: " + USAGE["init"])
        return cmd_init(a[1])
    if c in ("-V", "--version", "version"):
        n = len(bug_groups(bug_recs()))
        return print("gsdf %s  (%s)%s" % (VERSION, Path(__file__).resolve(),
                     "\n%d open bug report(s) — gsdf bugs" % n if n else ""))
    if c == "trace": return cmd_trace(a[1] if len(a) > 1 else "show")
    if c == "bug": return cmd_bug(" ".join(a[1:]).strip())
    if c == "bugs":
        if "--fixed" in a:
            i = a.index("--fixed")
            if len(a) <= i + 1: die("usage: " + USAGE["bugs"])
            return cmd_bugs_fixed(a[i + 1], " ".join(a[i + 2:]).strip())
        if "--count" in a: return cmd_bugs_count()
        return cmd_bugs("--clear" in a)
    if c == "update":
        # update returns before the generic flag check below, so it validates its own --
        # otherwise `gsdf update --forse` would quietly not force.
        u = [x for x in a[1:] if x.startswith("-") and x not in ("--check", "--force", "--main")]
        if u: die("unknown option: %s (gsdf update [--check] [--force] [--main])" % u[0])
        sys.exit(cmd_update("--check" in a, "--force" in a, "--main" in a))
    pl = planning()
    if c == "next": return cmd_next(pl)
    pl = pl or need()
    if c == "adopt": return cmd_adopt(pl)
    if c == "cfg": return cmd_cfg(pl, a[1:])
    if c == "rebuild": sys.exit(cmd_rebuild(pl))
    if c == "state":
        if len(a) == 1: return cmd_state(pl)
        s = a[1]
        # Empty text writes a dated bullet with nothing after the dash. execute.md says to run
        # `state defer` once per Deferred bullet, so a phase that deferred nothing gets one
        # junk line in STATE.md every time -- and STATE.md is what a human reads.
        txt = " ".join(a[2:]).strip()
        if s in ("note", "defer", "position") and not txt:
            die("usage: gsdf state %s \"<text>\" — refusing to write an empty entry" % s)
        if s == "set":
            if len(a) < 4 or not " ".join(a[3:]).strip(): die("usage: gsdf state set <key> <value>")
            with locked(pl): return state_set(pl, a[2], " ".join(a[3:]).strip())
        if s == "note":
            with locked(pl): return state_append(pl, r"Decisions(?:[ \t]+Made)?", "Decisions", "- %s — %s" % (date.today().isoformat(), txt))
        if s == "defer":
            with locked(pl): return state_append(pl, r"Deferred(?:[ \t]+Items)?", "Deferred", "- %s — %s" % (date.today().isoformat(), txt))
        if s == "position":
            with locked(pl): return state_position(pl, txt)
        if s == "sync":
            with locked(pl): state_sync(pl); return cmd_state(pl)
        die("unknown: gsdf state %s" % s)
    if c == "phase":
        s = a[1] if len(a) > 1 else "current"
        if s == "list": return cmd_list(pl)
        if s == "advance":
            with locked(pl): return cmd_advance(pl, find(pl, a[2]) if len(a) > 2 else None)
        p = find(pl, a[2] if len(a) > 2 else None)
        if s == "current": return print("%s %s %s" % (p["prefix"], p["slug"], p["status"]))
        if s == "dir":
            if not p["dir"]: new_dir(pl, p)
            return print(p["dir"].resolve())
        die("unknown: gsdf phase %s" % s)
    if c == "quick":
        if len(a) > 1 and a[1] == "new": return cmd_quick_new(pl, a[2] if len(a) > 2 else die("usage: gsdf quick new <slug>"))
        return print("\n".join(sorted(d.name for d in (pl / "quick").glob("*") if d.is_dir())) if (pl / "quick").is_dir() else "")
    if c == "iter":
        s = a[1] if len(a) > 1 else die("usage: gsdf iter start|log|list|count|approve <N> [text]")
        p = find(pl, a[2] if len(a) > 2 else None)
        if not p["dir"]: die("phase %s has no directory yet" % p["prefix"])
        if s == "start": return print(iter_start(p))
        if s == "approve": return print(iter_approve(p))
        if s == "log":
            with locked(pl): return iter_log(p, " ".join(a[3:]) or die("usage: gsdf iter log <N> \"<text>\""))
        if s == "list": return print("\n".join(iter_lines(p)))
        if s == "count": return print(len(iter_lines(p)))
        die("unknown: gsdf iter %s" % s)
    # Resolve the phase from the first POSITIONAL argument. Taking a[1] blindly made
    # `gsdf params --write` die with "bad phase: --write" -- and that is the exact
    # command cmd_params prints when the ABI check fails. An UNKNOWN flag is an error,
    # never a silent skip: `gsdf context --phase 2` would otherwise print the current
    # phase and look like it worked.
    unknown = [x for x in a[1:] if x.startswith("-") and x not in ("--write",)]
    if unknown: die("unknown option: %s (try `gsdf help`)" % unknown[0])
    pos = [x for x in a[1:] if not x.startswith("-")]
    # The ABI is the project's, not a phase's: resolving one first made `params` die with
    # "every phase is complete" on a finished milestone -- exactly when it matters most.
    if c == "params": sys.exit(cmd_params(pl, None, "--write" in a))
    p = find(pl, pos[0] if pos else None)
    if c == "plans": return print(json.dumps([{k: v for k, v in x.items() if k != "has_depends"} for x in plans_of(p["dir"], p["prefix"])], indent=2))
    if c == "waves": return print(json.dumps(waves(plans_of(p["dir"], p["prefix"]))))
    if c == "conflicts": return cmd_conflicts(pl, p)
    if c == "lint": return cmd_lint(pl, p)
    if c == "context": return cmd_context(pl, p)
    if c == "tryit": return cmd_tryit(pl, p)
    if c == "verify": sys.exit(cmd_verify(pl, p))
    if c == "findings": return cmd_findings(pl, p)
    die("unknown subcommand: %s (try `gsdf help`)" % c)

if __name__ == "__main__":
    try:
        main(sys.argv[1:])
        if sys.argv[1:2] != ["trace"]: trace_write(sys.argv[1:], 0)
    except BrokenPipeError: pass
    except KeyboardInterrupt: sys.exit(130)
    except SystemExit as e:
        if sys.argv[1:2] != ["trace"]: trace_write(sys.argv[1:], e.code if isinstance(e.code, int) else 1)
        raise
    except Exception as e:
        trace_write(sys.argv[1:], 1)
        # A crash is never correct behaviour, so record it without being asked. Zero tokens:
        # no agent is involved, and the frame is what makes it fixable later.
        bug_record("crash", "%s: %s" % (type(e).__name__, e), bug_frame(e))
        # Spec 5: "exit non-zero with a one-line error". A traceback breaks that promise,
        # and in an agent's tool output it is context burn the agent cannot act on. The
        # traceback is still one env var away when a human is the one debugging.
        if os.environ.get("GSDF_DEBUG"): raise
        die("%s: %s  [recorded — gsdf bugs]" % (type(e).__name__, e))
