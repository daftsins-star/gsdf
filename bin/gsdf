#!/usr/bin/env python3
"""gsdf - deterministic state tool for GSDF. Filesystem is the source of truth (spec 4a)."""
VERSION = "1.0.0"
import fcntl, hashlib, json, os, re, shutil, subprocess, sys, tempfile
from contextlib import contextmanager
from datetime import datetime, date
from pathlib import Path

def die(m): sys.stderr.write(m.rstrip() + "\n"); sys.exit(1)
def read(p):
    try: return Path(p).read_text(encoding="utf-8", errors="replace")
    except OSError: return ""
def slug(s): return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", s.lower())).strip("-") or "phase"
def norm(n): return str(float(n)).rstrip("0").rstrip(".") if "." in str(n) else str(int(n))
def key(n): return float(n)

def planning():
    d = Path.cwd().resolve()
    for c in [d, *d.parents]:
        if (c / ".planning").is_dir(): return c / ".planning"
    return None
def need(): return planning() or die("no .planning/ found — run `gsdf init <name>` or `/gsdf:new-project`")

# ---------- parsing ----------
def frontmatter(t):
    if not t.startswith("---"): return {}
    e = t.find("\n---", 3)
    if e < 0: return {}
    return {m[1]: m[2].strip() for m in (re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", l) for l in t[3:e].splitlines()) if m}
def as_list(v):
    v = (v or "").strip()
    if v.startswith("[") and v.endswith("]"): v = v[1:-1]
    return [x.strip().strip("\"'") for x in v.split(",") if x.strip()]
def dep_id(d):
    m = re.match(r"^\d+(?:\.\d+)?-(\d+)$", d.strip().strip("\"'"))
    return m.group(1) if m else d.strip().strip("\"'")
def section(t, *names):
    for n in names:
        m = re.search(r"^#{1,4}\s*%s\s*$(.*?)(?=^#{1,4}\s|\Z)" % n, t, re.M | re.S | re.I)
        if m and m.group(1).strip(): return m.group(1).strip()
    return ""
def cap(t, n): return "\n".join(t.splitlines()[:n])
def tail(t, n): return "\n".join(t.splitlines()[-n:])

ROADMAP_RE = re.compile(r"^[ \t]*(?:[-*][ \t]*\[[ xX✅⏳]?\][ \t]*)?#{0,4}[ \t]*\*{0,2}Phase[ \t]+(\d+(?:\.\d+)?)[ \t]*[:–—-][ \t]*(.+)$", re.M)
def roadmap_phases(pl):
    out = {}
    for m in ROADMAP_RE.finditer(read(pl / "ROADMAP.md")):
        n = norm(m.group(1))
        if n in out: continue
        name = re.split(r"\s+[-–—]\s+", m.group(2).split("**")[0])[0].strip(" *:—-")
        out[n] = name or ("phase-" + n)
    return out

PDIR_RE = re.compile(r"^(\d{2,3}(?:\.\d+)?)-(.+)$")
def dir_phases(pl):
    out = {}
    for d in sorted((pl / "phases").glob("*")) if (pl / "phases").is_dir() else []:
        m = PDIR_RE.match(d.name)
        if not (d.is_dir() and m): continue
        n = norm(m.group(1))
        if n in out:   # never silently drop a phase directory: its plans would vanish
            sys.stderr.write("warning: phase %s claimed by both %s and %s — using %s\n"
                             % (n, out[n][2].name, d.name, out[n][2].name))
            continue
        out[n] = (m.group(1), m.group(2), d)
    return out

def plans_of(pdir, prefix):
    out = []
    if not pdir: return out
    for f in sorted(pdir.glob(prefix + "-*-PLAN.md")):
        m = re.match(r"^%s-(\d+)-PLAN\.md$" % re.escape(prefix), f.name)
        if not m: continue
        txt = read(f); fm = frontmatter(txt); pid = m.group(1)
        s = pdir / ("%s-%s-SUMMARY.md" % (prefix, pid))
        files = sorted({x.strip() for grp in re.findall(r"<files>(.*?)</files>", txt, re.S) for x in grp.split(",") if x.strip()}
                       | set(as_list(fm.get("files_modified"))))
        out.append({"id": pid, "file": str(f), "depends_on": [dep_id(x) for x in as_list(fm.get("depends_on"))],
                    "has_depends": "depends_on" in fm, "wave": fm.get("wave"), "files": files, "has_summary": s.exists(),
                    "status": (frontmatter(read(s)).get("status", "complete") if s.exists() else "pending")})
    return out

def uat_passed(t):
    if re.search(r"^status:\s*(passed|pass|complete|approved)\s*$", t, re.M | re.I): return True
    if re.search(r"^\s*\*{0,2}Status\*{0,2}:\s*PASS", t, re.M): return True
    if re.search(r"^#{1,4}\s*Result:\s*pass", t, re.M | re.I): return True
    r = re.findall(r"^\s*result:\s*(\S+)", t, re.M | re.I)
    if r and all(x.lower() == "pass" for x in r): return True
    b = re.findall(r"\[([ xX])\]", t)
    return bool(b) and all(x.lower() == "x" for x in b)

def status_of(pdir, prefix):
    """Spec 4a: first match wins. Filesystem is truth; STATE.md and ROADMAP.md are never trusted."""
    if not pdir or not pdir.is_dir(): return "plan"
    f = lambda s: pdir / ("%s-%s.md" % (prefix, s))
    if f("ITERATIONS").exists() and re.search(r"^status:\s*approved", read(f("ITERATIONS")), re.M): return "complete"
    if f("UAT").exists() and uat_passed(read(f("UAT"))): return "complete"
    if f("VERIFICATION").exists() and re.search(r"passed|PASS", read(f("VERIFICATION"))): return "complete"
    pl = plans_of(pdir, prefix)
    if not pl: return "plan"
    # A blocked or partial summary is not a finished plan. Counting it as one makes a phase
    # that failed to build look executed, and sends the user into iterate mode on work that
    # does not exist.
    if any(x["status"] in ("blocked", "partial") for x in pl if x["has_summary"]): return "blocked"
    return "iterate" if all(x["has_summary"] for x in pl) else "execute"

def phases(pl):
    rm, dp, out = roadmap_phases(pl), dir_phases(pl), []
    for n in sorted(set(rm) | set(dp), key=key):
        prefix, sl, d = dp[n] if n in dp else (n.zfill(2), slug(rm[n]), None)
        out.append({"num": n, "prefix": prefix, "slug": sl, "dir": d, "name": rm.get(n, sl), "status": status_of(d, prefix)})
    return out
def current(pl): return next((p for p in phases(pl) if p["status"] != "complete"), None)
def find(pl, arg):
    ph = phases(pl)
    if arg in (None, "", "current"):
        return current(pl) or die("every phase is complete — run `gsdf next`")
    n = norm(re.sub(r"[^\d.]", "", str(arg)) or die("bad phase: %s" % arg))
    return next((p for p in ph if p["num"] == n), None) or die("phase %s not found" % arg)

def waves(plans):
    ids = [p["id"] for p in plans]
    if not ids: return []
    if all(p["has_depends"] for p in plans):
        rem = {p["id"]: set(p["depends_on"]) & set(ids) for p in plans}
        out = []
        while rem:
            layer = sorted([i for i, d in rem.items() if not d]) or sorted(rem)
            out.append(layer)
            for i in layer: rem.pop(i)
            for d in rem.values(): d -= set(layer)
        return out
    if all(p["wave"] for p in plans):
        g = {}
        for p in plans: g.setdefault(int(re.sub(r"\D", "", p["wave"]) or 1), []).append(p["id"])
        return [sorted(g[k]) for k in sorted(g)]
    return [[i] for i in ids]

@contextmanager
def locked(pl):
    """Serialise read-modify-write on .planning/. An orchestrator fires independent Bash calls
    in parallel — six concurrent `state defer` calls landed three of six lines without this.
    The lock lives in the system temp dir, keyed by path, so nothing is added to the repo."""
    key = hashlib.sha1(str(Path(pl).resolve()).encode()).hexdigest()[:16]
    f = open(Path(tempfile.gettempdir()) / ("gsdf-%s.lock" % key), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield
    finally:
        try: fcntl.flock(f, fcntl.LOCK_UN)
        finally: f.close()

# ---------- STATE.md ----------
POS = r"(?:Current[ \t]+)?Position|Current[ \t]+Status"
def head_span(t, pat):
    m = re.search(r"^#{1,4}[ \t]*(?:%s)[ \t]*$" % pat, t, re.M | re.I)
    if not m: return None
    nxt = re.search(r"^#{1,4}[ \t]", t[m.end():], re.M)
    return (m.start(), m.end(), m.end() + (nxt.start() if nxt else len(t) - m.end()))
def state_file(pl): return pl / "STATE.md"
def cmd_state(pl):
    t = read(state_file(pl)) or die("STATE.md not found")
    fm = t[:t.find("\n---", 3) + 4] if t.startswith("---") and t.find("\n---", 3) > 0 else ""
    sp = head_span(t, POS)
    print((fm + "\n" + (t[sp[0]:sp[2]] if sp else cap(t, 15))).strip())
def write_state(pl, t): state_file(pl).write_text(t, encoding="utf-8")
def state_set(pl, k, v):
    t = read(state_file(pl)) or die("STATE.md not found")
    if t.startswith("---") and t.find("\n---", 3) > 0:
        e = t.find("\n---", 3)
        head, body = t[3:e], t[e:]
        if re.search(r"^%s:" % re.escape(k), head, re.M):
            head = re.sub(r"^%s:.*$" % re.escape(k), "%s: %s" % (k, v), head, count=1, flags=re.M)
        else: head = head.rstrip("\n") + "\n%s: %s\n" % (k, v)
        t = "---" + head + body
    else:
        c = "<!-- gsdf: %s=%s -->" % (k, v)
        t = re.sub(r"^<!-- gsdf: %s=.*-->$" % re.escape(k), c, t, count=1, flags=re.M) if re.search(
            r"^<!-- gsdf: %s=" % re.escape(k), t, re.M) else re.sub(r"^(#[^\n]*\n)", r"\1\n" + c + "\n", t, count=1) or t + "\n" + c + "\n"
    write_state(pl, t)
def state_append(pl, pat, title, line):
    t = read(state_file(pl)) or die("STATE.md not found")
    sp = head_span(t, pat)
    if sp: t = t[:sp[2]].rstrip("\n") + "\n" + line + "\n\n" + t[sp[2]:]
    else: t = t.rstrip("\n") + "\n\n## %s\n\n%s\n" % (title, line)
    write_state(pl, t)
def state_position(pl, text):
    t = read(state_file(pl)) or die("STATE.md not found")
    sp = head_span(t, POS)
    if sp: t = t[:sp[1]] + "\n\n" + text + "\n\n" + t[sp[2]:]
    else: t = t.rstrip("\n") + "\n\n## Position\n\n" + text + "\n"
    write_state(pl, re.sub(r"\n{3,}", "\n\n", t))

# ---------- context ----------
def config(pl, strict=False):
    raw = read(pl / "config.json")
    try: return json.loads(raw or "{}")
    except json.JSONDecodeError as e:
        # Readers carry on with defaults; a writer must never overwrite a file it cannot parse.
        if strict: die("config.json is not valid JSON (%s) — fix it before adopting; "
                       "refusing to overwrite it and lose the keys it holds" % e)
        return {}
def roadmap_entry(pl, p):
    t = read(pl / "ROADMAP.md")
    m = re.search(r"^#{2,4}[ \t]*\*{0,2}Phase[ \t]+%s\b.*$" % re.escape(p["num"]), t, re.M)
    if not m: return ""
    nxt = re.search(r"^#{2,4}[ \t]", t[m.end():], re.M)
    return t[m.start():m.end() + (nxt.start() if nxt else len(t) - m.end())].strip()
REQ_START = re.compile(r"^\s*(?:[-*+]|\d+\.)\s*\**\s*(REQ-\d+)\b")
def req_blocks(text, wanted):
    """A requirement is a bullet plus its continuation lines, and only from a v1/v2 section.
    Line-filtering truncates wrapped requirements and lets an out-of-scope bullet that merely
    mentions an id masquerade as one."""
    out, keep, skip = [], False, False
    for line in text.splitlines():
        h = re.match(r"^#{1,4}\s*(.+)$", line)
        if h:
            skip = bool(re.search(r"out.of.scope|non-goals?|deferred", h.group(1), re.I))
            keep = False
            continue
        m = REQ_START.match(line)
        if m: keep = (m.group(1) in wanted) and not skip
        elif keep and line.strip() and not REQ_START.match(line) and not line[:1].strip():
            pass                      # indented continuation of the kept bullet
        elif keep and not line.strip():
            keep = False              # blank line ends the block
        elif keep:
            keep = False              # a new unindented bullet that is not a REQ
        if keep and line.strip(): out.append(line.rstrip())
    return out

def cmd_context(pl, p):
    out, cfg, proj = [], config(pl), read(pl / "PROJECT.md")
    out.append("## Project\n\n" + cap(section(proj, "Vision", "Overview", "Core Value") or cap(proj, 15), 15))
    for f, n in (("conventions.md", "Conventions"), ("stack.md", "Stack")):
        if (pl / "codebase" / f).exists():
            out.append("### %s\n\n%s" % (n, cap(re.sub(r"\A#[ \t][^\n]*\n+", "", read(pl / "codebase" / f)), 40)))
    entry = roadmap_entry(pl, p)
    out.append("## Phase %s\n\n%s" % (p["prefix"], entry or "%s — no ROADMAP entry found." % p["name"]))
    reqs = re.findall(r"REQ-\d+", entry)
    if reqs: out.append("## Requirements\n\n" + "\n".join(req_blocks(read(pl / "REQUIREMENTS.md"), reqs)))
    dec = section(read(state_file(pl)), "Decisions", "Decisions Made")
    if dec: out.append("## Decisions\n\n" + tail(dec, 20))
    ctx = p["dir"] and (p["dir"] / (p["prefix"] + "-CONTEXT.md"))
    if ctx and ctx.exists():
        body, full = read(ctx).strip(), read(ctx).strip().splitlines()
        if len(full) > 120:  # a long discuss would blow the 2.5k budget; point at the file instead
            body = "\n".join(full[:120]) + "\n\n[truncated at 120 lines — read %s in full if you need the rest]" % ctx
        out.append("## Context\n\n" + body)
    ch = next((c for c in [pl / "continue-here.md", p["dir"] and p["dir"] / ".continue-here.md"] if c and c.exists()), None)
    if ch: out.append("## Handoff (continue-here.md)\n\n" + cap(read(ch).strip(), 40))
    if cfg.get("verify"): out.append("## Verify commands\n\n```json\n%s\n```" % json.dumps(cfg["verify"], indent=2))
    # Say so out loud when there are none. Silence here reads exactly like a
    # configured project, and approve's promise ("nothing was approved that
    # doesn't build") is unenforceable without commands to run.
    else: out.append("## Verify commands\n\nNONE CONFIGURED — `config.json` has no `verify` entries, so there is\nnothing for execute or approve to run. Plans must carry their own\n`<verify>` commands, and approve cannot claim this phase builds. Fix with\n`gsdf init` in a project that has a build, or add `verify.build` /\n`verify.test` / `verify.ui` by hand.")
    prev = [x for x in phases(pl) if key(x["num"]) < key(p["num"]) and x["dir"]]
    if prev:
        q = prev[-1]
        b = [x for x in (section(read(f), "Delivered") + "\n" + section(read(f), "Iterations")
             for f in sorted(q["dir"].glob(q["prefix"] + "-*-SUMMARY.md"))) if x.strip()]
        if b: out.append("## Previous phase (%s)\n\n%s" % (q["prefix"], "\n\n".join(x.strip() for x in b)))
    print("\n\n".join(out))
def cmd_conflicts(pl, p):
    """Two plans in the same wave must never touch the same file. Exit 1 if any do."""
    plans = {x["id"]: x for x in plans_of(p["dir"], p["prefix"])}
    bad = 0
    for w in waves(list(plans.values())):
        for i, a in enumerate(w):
            for b in w[i + 1:]:
                shared = sorted(set(plans[a]["files"]) & set(plans[b]["files"]))
                if shared:
                    bad += 1
                    print("wave conflict: %s-%s and %s-%s both write %s" % (p["prefix"], a, p["prefix"], b, ", ".join(shared)))
    if bad: sys.exit(1)
    print("no same-wave file conflicts in phase %s" % p["prefix"])

def cmd_lint(pl, p):
    """The gates /gsdf:plan applies before an executor ever sees a plan. Prose checks get
    skipped; a command does not. Exit 1 and name the plan and the problem."""
    bad = []
    for x in plans_of(p["dir"], p["prefix"]):
        f, txt = Path(x["file"]), read(x["file"])
        fm, pid = frontmatter(txt), "%s-%s" % (p["prefix"], x["id"])
        try: est = int(re.sub(r"\D", "", fm.get("estimated_tokens", "")) or 0)
        except ValueError: est = 0
        if not est: bad.append("%s: no estimated_tokens" % pid)
        elif est >= 120000: bad.append("%s: estimated_tokens %d exceeds the 120000 executor budget" % (pid, est))
        if not as_list(fm.get("requirements")): bad.append("%s: requirements is empty" % pid)
        v, fw = len(re.findall(r"<verify>", txt)), len(re.findall(r"<fails_when>", txt))
        if v and fw < v: bad.append("%s: %d <verify> but only %d <fails_when> — a command with no expressible failure mode is not an acceptance test" % (pid, v, fw))
        if not v: bad.append("%s: no <verify> in any task" % pid)
        if len(re.findall(r"<task", txt)) > len(re.findall(r"<done>", txt)):
            bad.append("%s: a task has no <done>" % pid)
        if not section(txt, "Try it"): bad.append("%s: no '## Try it' — the user cannot see the result" % pid)
    for b in bad: print(b)
    if bad: sys.exit(1)
    print("phase %s: %d plan(s) pass all gates" % (p["prefix"], len(plans_of(p["dir"], p["prefix"]))))

def cmd_tryit(pl, p):
    files = sorted(p["dir"].glob(p["prefix"] + "-*-SUMMARY.md")) if p["dir"] else []
    for f in files:
        t = read(f); hc = section(t, "Needs human check")
        body = "\n\n".join(x for x in [section(t, "Try it"), "**Needs human check**\n" + hc if hc else ""] if x)
        print("### %s\n\n%s\n" % (f.name, (body or section(t, "Delivered", "Accomplishments", "What was built") or cap(t, 20)).strip()))
    if not files: print("No SUMMARY.md files in phase %s yet." % p["prefix"])

# ---------- iterations / quick ----------
def iter_file(p): return p["dir"] / (p["prefix"] + "-ITERATIONS.md")
def iter_log(p, text):
    f = iter_start(p)
    f.write_text(read(f).rstrip("\n") + "\n- %s — %s\n" % (datetime.now().strftime("%H:%M"), text), encoding="utf-8")
    snapshot(f.parent, p["prefix"])

def snapshot(cwd, prefix):
    """Iterate mode deliberately makes no commits, so a whole session lives in the worktree.
    Park a recoverable snapshot in refs/gsdf/ — not a commit on any branch, invisible to
    git log and git status, and restorable with `git stash apply <ref>`."""
    import subprocess
    try:
        h = subprocess.run(["git", "stash", "create"], cwd=cwd, capture_output=True, text=True, timeout=15)
        sha = h.stdout.strip()
        if h.returncode == 0 and sha:
            subprocess.run(["git", "update-ref", "refs/gsdf/iter/%s/%s" % (prefix, sha[:8]), sha],
                           cwd=cwd, capture_output=True, timeout=15)
    except Exception:
        pass                                    # never let a snapshot failure break a log call
def iter_start(p):
    """Create NN-ITERATIONS.md with no entries. Logging a placeholder line to create the file
    would count as a change, inflating approve's tally and the every-10 reminder."""
    f = iter_file(p)
    if not f.exists():
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text("---\nphase: %s\nstatus: open\nstarted: %s\napproved: \n---\n# Iterations — Phase %s\n\n"
                     % (p["prefix"], datetime.now().strftime("%Y-%m-%dT%H:%M"), p["prefix"]), encoding="utf-8")
    return f

def iter_approve(p):
    f = iter_file(p)
    if not f.exists(): iter_start(p)
    s = re.sub(r"^status:.*$", "status: approved", read(f), count=1, flags=re.M)
    f.write_text(re.sub(r"^approved:.*$", "approved: " + datetime.now().strftime("%Y-%m-%dT%H:%M"), s, count=1, flags=re.M), encoding="utf-8")
    return f

def iter_lines(p):
    f = iter_file(p)
    return [l for l in read(f).splitlines() if l.startswith("- ")] if f.exists() else []

# ---------- init / adopt ----------
def templates():
    here = Path(__file__).resolve().parent
    for c in [here / "../skills/gsdf-templates", here / "../.claude/skills/gsdf-templates",
              Path.cwd() / ".claude/skills/gsdf-templates", Path.home() / ".claude/skills/gsdf-templates"]:
        if c.is_dir(): return c.resolve()
    return None
def detect(root):
    cfg = {"verify": {}, "phases_per_milestone": 4, "research": "auto"}
    cm = read(root / "CMakeLists.txt")
    m = re.search(r"project\s*\(\s*([A-Za-z0-9_\-]+)", cm)
    name = m.group(1) if m else "<Plugin>"
    if cm:
        cfg["verify"].update(build="cmake --build build --config Release", test="ctest --test-dir build --output-on-failure")
        cfg["standalone_target"] = name + "_Standalone"
    ui = next((d for d in ("ui", "Source/ui", "web") if (root / d / "package.json").exists()), None)
    if ui:
        try: sc = json.loads(read(root / ui / "package.json")).get("scripts", {})
        except json.JSONDecodeError: sc = {}
        cfg["ui_dir"] = ui
        # "test" is the convention, but a UI that is tested through a named script
        # (test:ui, test:e2e) is otherwise silently recorded as having no tests.
        t = next((k for k in ("test", "test:ui", "test:e2e", "test:unit") if k in sc), None)
        if t: cfg["verify"]["ui"] = "cd %s && npm run %s" % (ui, t)
        if "dev" in sc: cfg["verify"]["ui_dev"] = "cd %s && npm run dev" % ui
    # A repo that ships its own validator knows more than a guess does: sinemill's
    # scripts/validate.sh already does universal-binary + pluginval + auval, and
    # fetches pluginval itself. Prefer it, and write NOTHING rather than a
    # placeholder string -- a placeholder is a command `gsdf verify` will try to
    # run, which fails confusingly instead of being honestly absent.
    if (root / "scripts" / "validate.sh").exists():
        cfg["verify"]["plugin_validate"] = "bash scripts/validate.sh"
        cfg["verify"]["plugin_release"] = "bash scripts/validate.sh --release --strict build-release"
    elif shutil.which("pluginval"):
        cfg["verify"]["plugin_validate"] = ("pluginval --strictness-level 5 --validate "
                                            "build/%s_artefacts/Release/VST3/%s.vst3" % (name, name))
    return cfg
def merge(dst, src):
    for k, v in src.items():
        if isinstance(v, dict) and isinstance(dst.get(k), dict): merge(dst[k], v)
        elif k not in dst or dst.get(k) in ("", None): dst[k] = v
    return dst
def cmd_verify(pl, p):
    """Run the phase's verification and report honestly. Exit non-zero on failure.

    This lives here rather than in approve.md because it is a CHECK, and a check
    written as prompt text is a check that can be forgotten. The bug it exists to
    stop is specific: approve used to print "Verified: build OK test OK" from a
    template, whether or not any command ran -- and a project whose config.json
    has no verify block looked exactly like one that passed.
    """
    cfg = config(pl)
    v = cfg.get("verify") or {}
    # plugin_release is the milestone gate, not a per-phase one: it is a full
    # Release build plus auval. Left out here deliberately.
    cmds = [(k, v[k]) for k in ("build", "test", "ui", "plugin_validate")
            if v.get(k) and not str(v[k]).startswith("<")]
    src = "config.json"
    if not cmds:
        # Fall back to the plans' own <verify> commands: a phase can be provably
        # green without a project-level build, and silence would misreport that.
        seen, pv = set(), []
        for pl_ in plans_of(p["dir"], p["prefix"]):
            for m in re.finditer(r"<verify>(.*?)</verify>", read(Path(pl_["file"])), re.S):
                c = m.group(1).strip()
                if c and c not in seen:
                    seen.add(c); pv.append(("plan %s" % pl_["id"], c))
        cmds, src = pv, "plan <verify> blocks"
    if not cmds:
        print("NONE CONFIGURED — no `verify` in config.json and no <verify> in any plan.\n"
              "Nothing can be proven about phase %s. Add verify.build / verify.test, or run `gsdf init`." % p["prefix"])
        return 2
    print("verify %s — %d command(s) from %s" % (p["prefix"], len(cmds), src))
    bad = 0
    for name, c in cmds:
        r = subprocess.run(c, shell=True, capture_output=True, text=True)
        tail = [l for l in (r.stdout + r.stderr).splitlines() if l.strip()][-1:] or [""]
        print("  %-22s exit %d  %s" % (name, r.returncode, tail[0][:100]))
        if r.returncode: bad += 1
    print("verify: %d/%d passed" % (len(cmds) - bad, len(cmds)))
    return 1 if bad else 0


def cmd_findings(pl, p):
    """Print what this phase captured as reusable, for approve to collate.

    Two sources, both written at the moment the lesson was learned: iteration
    lines prefixed FINDING:, and `## Findings` sections in plan summaries.
    Nothing here judges -- judging later, from a record written for another
    purpose, is exactly what the findings format exists to avoid.
    """
    out = []
    for l in iter_lines(p):
        # Lines are "- HH:MM — FINDING: ...", so anchoring on ^FINDING: matches
        # nothing. Match the prefix anywhere after the timestamp.
        m = re.search(r"FINDING:\s*(.+)$", l)
        if m: out.append(("iterate", m.group(1).strip()))
    for x in plans_of(p["dir"], p["prefix"]):
        txt = read(Path(x["file"]).with_name(Path(x["file"]).name.replace("-PLAN.md", "-SUMMARY.md")))
        m = re.search(r"^## Findings\s*$(.*?)(?=^## |\Z)", txt, re.S | re.M)
        if m:
            for line in m.group(1).splitlines():
                if line.strip().startswith("- "): out.append(("plan %s" % x["id"], line.strip()[2:]))
    if not out:
        print("no findings captured in phase %s — normal; nothing reusable is a real answer" % p["prefix"])
        return 0
    for where, text in out: print("[%s] %s" % (where, text))
    return 0


def cmd_adopt(pl):
    (pl / "config.json").write_text(json.dumps(merge(config(pl, strict=True), detect(pl.parent)), indent=2) + "\n", encoding="utf-8")
    print("Adopted %s" % pl); cmd_list(pl); print(); cmd_next(pl)
def cmd_init(name):
    root = Path.cwd(); pl = root / ".planning"
    if pl.is_dir(): die(".planning/ already exists — run `gsdf adopt`")
    t = templates() or die("templates not found (looked for .claude/skills/gsdf-templates)")
    (pl / "phases").mkdir(parents=True); (pl / "quick").mkdir()
    sub = {"{{NAME}}": name, "{{DATE}}": date.today().isoformat(), "{{MILESTONE}}": "v1.0"}
    for dst in ("PROJECT.md", "ROADMAP.md", "STATE.md"):
        s = read(t / dst.replace(".md", ".template.md"))
        for k, v in sub.items(): s = s.replace(k, v)
        (pl / dst).write_text(s, encoding="utf-8")
    (pl / "config.json").write_text(json.dumps(detect(root), indent=2) + "\n", encoding="utf-8")
    print("Initialised %s for %s" % (pl, name))

# ---------- output commands ----------
def cmd_next(pl):
    if not pl: return print("new-project")
    ph = phases(pl)
    if not ph:
        # No roadmap phases and no phase directories. That is an unstarted or unparseable
        # project, never a finished milestone — saying milestone-done here would invite
        # progress --next to archive and tag a project that has done nothing.
        return print("new-project")
    p = next((x for x in ph if x["status"] != "complete"), None)
    print("milestone-done" if not p else "%s %s" % (p["status"], p["prefix"]))
def cmd_list(pl):
    print("| NN | slug | status | plans | done | iterations |\n|---|---|---|---|---|---|")
    for p in phases(pl):
        pls = plans_of(p["dir"], p["prefix"])
        print("| %s | %s | %s | %d | %d | %d |" % (p["prefix"], p["slug"], p["status"], len(pls),
              sum(1 for x in pls if x["has_summary"]), len(iter_lines(p)) if p["dir"] else 0))
def cmd_advance(pl, p=None):
    """Advance an EXPLICIT phase. Defaulting to current() is a trap: approve stamps the
    phase's ITERATIONS approved first, so by the time advance runs, current() has already
    moved on and advance would mark the NEXT, unstarted phase complete."""
    p = p or current(pl) or die("every phase is already complete")
    if not p["dir"]:
        p["dir"] = pl / "phases" / ("%s-%s" % (p["prefix"], p["slug"])); p["dir"].mkdir(parents=True, exist_ok=True)
    iter_approve(p)
    t = read(pl / "ROADMAP.md"); orig = t
    t = re.sub(r"^([ \t]*[-*][ \t]*)\[[ ]\]([ \t]*\**Phase[ \t]+%s\b)" % re.escape(p["num"]), r"\1[x]\2", t, count=1, flags=re.M)
    blk = re.search(r"^#{2,4}[ \t]*\*{0,2}Phase[ \t]+%s\b.*?(?=^#{2,4}[ \t]|\Z)" % re.escape(p["num"]), t, re.M | re.S)
    if blk:
        nb = re.sub(r"(\*{0,2}Status\*{0,2}:[ \t]*)(pending|in progress|planned|todo)", r"\1complete", blk.group(0), flags=re.I)
        nb = nb.replace("⏳", "✅"); t = t[:blk.start()] + nb + t[blk.end():]
    if t == orig: t = t.rstrip("\n") + "\n\n<!-- gsdf: phase %s complete -->\n" % p["prefix"]
    (pl / "ROADMAP.md").write_text(t, encoding="utf-8")
    nxt = next((x for x in phases(pl) if key(x["num"]) > key(p["num"]) and x["status"] != "complete"), None) or current(pl)
    state_set(pl, "phase", nxt["prefix"] if nxt else p["prefix"])
    print("Phase %s complete. Next: %s" % (p["prefix"], (nxt["prefix"] + " " + nxt["slug"]) if nxt else "milestone-done"))
def cmd_quick_new(pl, s):
    q = pl / "quick"; q.mkdir(exist_ok=True)
    n = max([int(m.group(1)) for d in q.glob("*") if d.is_dir() and (m := re.match(r"^(\d+)-", d.name))] or [0]) + 1
    d = q / ("%03d-%s" % (n, slug(s))); d.mkdir(); print(d)

def main(a):
    c = a[0] if a else "next"
    if c == "init": return cmd_init(a[1] if len(a) > 1 else die("usage: gsdf init <name>"))
    if c in ("-V", "--version", "version"):
        return print("gsdf %s  (%s)" % (VERSION, Path(__file__).resolve()))
    if c in ("-h", "--help", "help"): return print(__doc__ + "\nSubcommands: init adopt state next phase plans waves conflicts lint context tryit iter quick")
    pl = planning()
    if c == "next": return cmd_next(pl)
    pl = pl or need()
    if c == "adopt": return cmd_adopt(pl)
    if c == "state":
        if len(a) == 1: return cmd_state(pl)
        s = a[1]
        if s == "set":
            with locked(pl): return state_set(pl, a[2], " ".join(a[3:]))
        if s == "note":
            with locked(pl): return state_append(pl, r"Decisions(?:[ \t]+Made)?", "Decisions", "- %s — %s" % (date.today().isoformat(), " ".join(a[2:])))
        if s == "defer":
            with locked(pl): return state_append(pl, r"Deferred(?:[ \t]+Items)?", "Deferred", "- %s — %s" % (date.today().isoformat(), " ".join(a[2:])))
        if s == "position":
            with locked(pl): return state_position(pl, " ".join(a[2:]))
        die("unknown: gsdf state %s" % s)
    if c == "phase":
        s = a[1] if len(a) > 1 else "current"
        if s == "list": return cmd_list(pl)
        if s == "advance":
            with locked(pl): return cmd_advance(pl, find(pl, a[2]) if len(a) > 2 else None)
        p = find(pl, a[2] if len(a) > 2 else None)
        if s == "current": return print("%s %s %s" % (p["prefix"], p["slug"], p["status"]))
        if s == "dir":
            if not p["dir"]:
                p["dir"] = pl / "phases" / ("%s-%s" % (p["prefix"], p["slug"])); p["dir"].mkdir(parents=True, exist_ok=True)
            return print(p["dir"].resolve())
        die("unknown: gsdf phase %s" % s)
    if c == "quick":
        if len(a) > 1 and a[1] == "new": return cmd_quick_new(pl, a[2] if len(a) > 2 else die("usage: gsdf quick new <slug>"))
        return print("\n".join(sorted(d.name for d in (pl / "quick").glob("*") if d.is_dir())) if (pl / "quick").is_dir() else "")
    if c == "iter":
        s = a[1] if len(a) > 1 else die("usage: gsdf iter start|log|list|count|approve <N> [text]")
        p = find(pl, a[2] if len(a) > 2 else None)
        if not p["dir"]: die("phase %s has no directory yet" % p["prefix"])
        if s == "start": return print(iter_start(p))
        if s == "approve": return print(iter_approve(p))
        if s == "log":
            with locked(pl): return iter_log(p, " ".join(a[3:]) or die("usage: gsdf iter log <N> \"<text>\""))
        if s == "list": return print("\n".join(iter_lines(p)))
        if s == "count": return print(len(iter_lines(p)))
        die("unknown: gsdf iter %s" % s)
    p = find(pl, a[1] if len(a) > 1 else None)
    if c == "plans": return print(json.dumps([{k: v for k, v in x.items() if k != "has_depends"} for x in plans_of(p["dir"], p["prefix"])], indent=2))
    if c == "waves": return print(json.dumps(waves(plans_of(p["dir"], p["prefix"]))))
    if c == "conflicts": return cmd_conflicts(pl, p)
    if c == "lint": return cmd_lint(pl, p)
    if c == "context": return cmd_context(pl, p)
    if c == "tryit": return cmd_tryit(pl, p)
    if c == "verify": sys.exit(cmd_verify(pl, p))
    if c == "findings": return cmd_findings(pl, p)
    die("unknown subcommand: %s (try `gsdf help`)" % c)

if __name__ == "__main__":
    try: main(sys.argv[1:])
    except BrokenPipeError: pass
